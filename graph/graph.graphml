<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
<key id="label" for="node" attr.name="label" attr.type="string"/>
<key id="type" for="node" attr.name="type" attr.type="string"/>
<key id="description" for="node" attr.name="description" attr.type="string"/>
<key id="rel" for="edge" attr.name="type" attr.type="string"/>
<key id="evidence" for="edge" attr.name="evidence" attr.type="string"/>
<graph id="kg" edgedefault="directed">
<node id="ac_drives"><data key="label">AC drives</data><data key="type">Application</data><data key="description"></data></node>
<node id="acim"><data key="label">ACIM</data><data key="type">Motor</data><data key="description">Asynchronous/induction machine: rotor speed differs from rotor flux speed (slip); needs non-zero flux reference and a current model to compute rotor flux angle.</data></node>
<node id="adc"><data key="label">ADC</data><data key="type">Peripheral</data><data key="description">Samples motor phase currents, phase voltages and DC bus voltage; read via HAL_readAdcData. Max ADC input is 3.3 V.</data></node>
<node id="adc_offset_calibration"><data key="label">ADC offset calculation</data><data key="type">Feature</data><data key="description">Calibration of phase current/voltage offsets; current offsets near 2048 (half 12-bit scale), voltage offset coefficients about 0.5.</data></node>
<node id="adc_scaling"><data key="label">ADC current/voltage scaling</data><data key="type">Concept</data><data key="description">Max phase current/voltage at ADC input, based on sensing circuitry; defines scale factors assuming 12-bit ADC.</data></node>
<node id="additional_functionality"><data key="label">Adding additional functionality</data><data key="type">Feature</data><data key="description">Section 4.1.3: interface functions to start/stop the motor and set speed via push button, potentiometer, SCI or CAN.</data></node>
<node id="aes"><data key="label">AES tables</data><data key="type">Peripheral</data><data key="description">AES tables for security.</data></node>
<node id="air_conditioner_fan"><data key="label">Air-conditioner fan drive</data><data key="type">Application</data><data key="description">Flying start is important for fan drive in air-condition applications.</data></node>
<node id="alpha_beta_reference_frame"><data key="label">alpha-beta stationary reference frame</data><data key="type">Concept</data><data key="description">Two-axis orthogonal stationary frame with alpha aligned with phase a.</data></node>
<node id="angle_gen_run"><data key="label">ANGLE_GEN_run</data><data key="type">Software</data><data key="description">Ramp angle generator for open-loop running.</data></node>
<node id="angle_generator"><data key="label">Angle generator library</data><data key="type">Software</data><data key="description">MotorControl SDK library module for angle generation.</data></node>
<node id="appliances"><data key="label">Appliances</data><data key="type">Application</data><data key="description"></data></node>
<node id="arctangent_angle_calculation"><data key="label">Arctangent angle calculation</data><data key="type">Algorithm</data><data key="description">Rotor position computed directly from arctangent of estimated back-EMF; accuracy affected by noise and harmonics.</data></node>
<node id="arm_cortex_m4"><data key="label">Arm Cortex-M4</data><data key="type">Component</data><data key="description">Arm Cortex-M4 processor core.</data></node>
<node id="automotive"><data key="label">Automotive</data><data key="type">Application</data><data key="description"></data></node>
<node id="aux_power_supply_module"><data key="label">Aux power supply module</data><data key="type">Component</data><data key="description">TMDSHVMTRINSPIN aux supply sourcing from bridge or PFC output per [Main]-J2.</data></node>
<node id="back_emf"><data key="label">Back-EMF</data><data key="type">Concept</data><data key="description">Voltage induced by rotor; field weakening reduces it; speed and position estimated from BEMF voltages when spinning.</data></node>
<node id="bang_bang_control"><data key="label">Bang-bang control</data><data key="type">Algorithm</data><data key="description">Sign-function switching of the current estimation error producing sliding feedback z.</data></node>
<node id="base_speed"><data key="label">Base speed</data><data key="type">Concept</data><data key="description">Field weakening extends operation above base speed / rated speed.</data></node>
<node id="beta_fw"><data key="label">beta_fw</data><data key="type">Concept</data><data key="description">Current angle output of the FW PI controller.</data></node>
<node id="beta_mtpa"><data key="label">beta_mtpa</data><data key="type">Concept</data><data key="description">Current angle generated by MTPA control.</data></node>
<node id="bldc"><data key="label">BLDC</data><data key="type">Motor</data><data key="description">Brushless DC motor driven by C2000 MCUs with BLDC motor drivers.</data></node>
<node id="boostxl_3phganinv"><data key="label">BOOSTXL-3PHGANINV</data><data key="type">EvaluationKit</data><data key="description">48-V/10-A three-phase GaN inverter with precision in-line shunt-based phase current sensing and DC bus/three-phase voltage sensing.</data></node>
<node id="boostxl_drv8320rs"><data key="label">BOOSTXL-DRV8320RS</data><data key="type">EvaluationKit</data><data key="description">Kit whose MotorControl SDK solution folder (solutions/boostxl_drv8320rs) holds F28004x InstaSPIN-FOC labs.</data></node>
<node id="boostxl_drv8323rh"><data key="label">BOOSTXL-DRV8323RH</data><data key="type">EvaluationKit</data><data key="description">15-A three-phase BLDC drive stage based on DRV8323RH gate driver and CSD88599Q5DC NexFET power blocks, with three low-side current shunt amplifiers and voltage sensing.</data></node>
<node id="boostxl_drv8323rs"><data key="label">BOOSTXL-DRV8323RS</data><data key="type">EvaluationKit</data><data key="description">15-A three-phase BLDC drive stage based on DRV8323RS gate driver and CSD88599Q5DC NexFET power blocks, with three low-side current shunt amplifiers, IDRIVE and SPI-configurable protection.</data></node>
<node id="braking"><data key="label">Braking</data><data key="type">Feature</data><data key="description">Additional feature evaluated in build level 4.</data></node>
<node id="build_level_1"><data key="label">Build Level 1</data><data key="type">BuildLevel</data><data key="description">DMC_LEVEL_1: open-loop 50% PWM duty with motor disconnected; verifies HAL peripheral init, PWM and ADC drivers, ADC offset calibration.</data></node>
<node id="build_level_2"><data key="label">Build Level 2</data><data key="type">BuildLevel</data><data key="description">DMC_LEVEL_2: open-loop scalar v/f control validating current/voltage sensing, gate driver, and FAST or eSMO estimators.</data></node>
<node id="build_level_3"><data key="label">Build Level 3</data><data key="type">BuildLevel</data><data key="description">DMC_LEVEL_3: closed current loop (i/f) with angle from ramp generator; verifies current sensing parameters.</data></node>
<node id="build_level_4"><data key="label">Build Level 4</data><data key="type">BuildLevel</data><data key="description">DMC_LEVEL_4: speed and current closed loop with FAST/eSMO/encoder/Hall angle; motor identification with FAST and features such as FWC, flying start, MTPA, braking.</data></node>
<node id="c2000"><data key="label">C2000</data><data key="type">Device</data><data key="description">TI C2000 real-time microcontroller platform targeted by the universal lab.</data></node>
<node id="c2000_academy"><data key="label">C2000 Academy</data><data key="type">Software</data><data key="description">C2000 MCU Academy training resources: getting started resources, interactive classes, advanced workshops, videos.</data></node>
<node id="c2000_compiler"><data key="label">C2000 Compiler</data><data key="type">Software</data><data key="description">Compiler required by the Universal Motor Control Lab.</data></node>
<node id="c2000_design_development"><data key="label">C2000 Design &amp; Development</data><data key="type">Document</data><data key="description">C2000 design and development resources.</data></node>
<node id="c2000_e2e_forum"><data key="label">TI C2000 E2E forum</data><data key="type">Software</data><data key="description">Forum for searching or asking design questions (Step 5).</data></node>
<node id="c2000_generation_3"><data key="label">C2000 Generation 3 MCU portfolio</data><data key="type">Concept</data><data key="description">Generation 3 C2000 MCU portfolio; all devices compatible with C2000Ware, with pin-to-pin compatibility between many devices.</data></node>
<node id="c2000_jtag_connectivity_debug"><data key="label">C2000 MCU JTAG Connectivity Debug</data><data key="type">Document</data><data key="description">TI reference document.</data></node>
<node id="c2000_overview"><data key="label">C2000 Overview</data><data key="type">Document</data><data key="description">General information on C2000 real-time MCUs.</data></node>
<node id="c2000_products"><data key="label">C2000 Products</data><data key="type">Document</data><data key="description">C2000 product listing.</data></node>
<node id="c2000_rtc_peripheral_reference_guide"><data key="label">C2000 Real-Time Control Peripheral Reference Guide</data><data key="type">Document</data><data key="description">Describes differences between devices and peripheral versions.</data></node>
<node id="c2000ware"><data key="label">C2000Ware</data><data key="type">Software</data><data key="description">Cohesive set of development software and documentation for C2000: device-specific drivers, bit fields, libraries, peripheral examples, utilities, hardware files and documentation.</data></node>
<node id="c2000ware_libraries"><data key="label">C2000Ware libraries</data><data key="type">Software</data><data key="description">Math, digital signal processing, control and signal generation libraries in C2000Ware.</data></node>
<node id="c28x_compiler_ug_v22_6"><data key="label">TMS320C28x Optimizing C/C++ Compiler v22.6.0.LTS User's Guide</data><data key="type">Document</data><data key="description">Compiler guide; section 2.3 table 2-1 Processor Options describes options like idiv_support.</data></node>
<node id="c28x_cpu"><data key="label">C28x DSP core</data><data key="type">Component</data><data key="description">TI C28x 32-bit DSP CPU core used in C2000 MCUs.</data></node>
<node id="can"><data key="label">CAN</data><data key="type">Peripheral</data><data key="description">CAN bus (CANA) that can be added for start/stop commands and feedback of running states.</data></node>
<node id="can_command_control"><data key="label">CAN command control</data><data key="type">Feature</data><data key="description">CAN bus for start/stop commands and feedback, enabled by CMD_CAN_EN.</data></node>
<node id="can_fd_driver_simma"><data key="label">Simma Software CAN FD driver</data><data key="type">Software</data><data key="description">CAN FD device driver from Simma Software compatible with the F2838x family.</data></node>
<node id="canaisr"><data key="label">canaISR()</data><data key="type">Parameter</data><data key="description">CAN interrupt service routine handling TX/RX message objects; placed in .TI.ramfunc and acknowledged in PIE group 9.</data></node>
<node id="cb_change_pin_assignment"><data key="label">Change pin assignment</data><data key="type">Feature</data><data key="description">Custom board migration step 4: Change GPIO mux, direction and pad configuration in HAL_setupGPIOs() to match the board.</data></node>
<node id="cb_configure_adc"><data key="label">Configure ADC module</data><data key="type">Feature</data><data key="description">Custom board migration step 6: Define ADC base, result, channel, SOC and PPB numbers and interrupt sources in hal.h; set up SOCs in HAL_setupADCs().</data></node>
<node id="cb_configure_cmpss"><data key="label">Configure CMPSS module</data><data key="type">Feature</data><data key="description">Custom board migration step 7: Define CMPSS bases and ADC-to-CMPSS mux selects in hal.h; HAL_setupCMPSSs() configures comparators, filters and DACs.</data></node>
<node id="cb_configure_fault_protection"><data key="label">Configure fault protection</data><data key="type">Feature</data><data key="description">Custom board migration step 8: Define nFAULT GPIO and X-BAR trip muxes in hal.h; HAL_setupMtrFaults() configures X-BAR and ePWM trip zones.</data></node>
<node id="cb_configure_pwm"><data key="label">Configure PWM module</data><data key="type">Feature</data><data key="description">Custom board migration step 5: Define PWM base addresses in hal.h, GPIO PWM outputs, PWM period, dead band, and ADC SOC trigger.</data></node>
<node id="cb_hardware_setup"><data key="label">Custom board hardware setup</data><data key="type">Feature</data><data key="description">Custom board migration step 1: Verify MCU and gate driver power supplies are correct and the JTAG emulator connects.</data></node>
<node id="cb_modify_motor_control_parameters"><data key="label">Modify motor control parameters</data><data key="type">Feature</data><data key="description">Custom board migration step 3: Set motor type, pole pairs, Rs, Ls, flux and max current in user_mtr1.h from datasheet or FAST ID.</data></node>
<node id="cb_set_hardware_board_parameters"><data key="label">Set hardware board parameters</data><data key="type">Feature</data><data key="description">Custom board migration step 2: Set ADC full-scale current/voltage, filter pole, and sensor counts in user_mtr1.h per the sensing circuit.</data></node>
<node id="ccs_expressions_window"><data key="label">CCS Expressions Window</data><data key="type">Software</data><data key="description">CCS watch view (View -&gt; Expressions) used to watch and set variables; variable groups can be imported from universal_lab_levelN.txt files.</data></node>
<node id="ccs_graph_tool"><data key="label">CCS Graph Tool</data><data key="type">Software</data><data key="description">Graph tool in CCS that displays arrays of data in device memory in various graphical types; used with DATALOG.</data></node>
<node id="ccs_resource_explorer"><data key="label">TI Resource Explorer</data><data key="type">Software</data><data key="description">Resource Explorer view in Code Composer Studio (and online) used to navigate and import MotorControl SDK content.</data></node>
<node id="ccxml_target_config"><data key="label">Target configuration file (.ccxml)</data><data key="type">Software</data><data key="description">Debugger target configuration, e.g. TMS320F280025C_LaunchPad.ccxml for LAUNCHXL-F280025C and TMS320F280025C.ccxml for TMDSCNCD280025C.</data></node>
<node id="cla"><data key="label">CLA</data><data key="type">Peripheral</data><data key="description">Control Law Accelerator co-processor for parallel control or signal processing.</data></node>
<node id="clarke_run"><data key="label">CLARKE_run</data><data key="type">Software</data><data key="description">Clarke transformation for current or voltage.</data></node>
<node id="clarke_transform"><data key="label">Clarke transform</data><data key="type">Algorithm</data><data key="description">Projects 3-phase (a,b,c) quantities into the 2-axis orthogonal stationary (alpha,beta) frame; output is time-variant.</data></node>
<node id="clb"><data key="label">CLB</data><data key="type">Peripheral</data><data key="description">Configurable logic block: high-speed programmable logic integrated into a C2000 MCU with I/O routing to ePWM, eCAP, eQEP and GPIO.</data></node>
<node id="clb_config_header"><data key="label">CLB configuration header (*.h)</data><data key="type">Software</data><data key="description">Header file generated by the project build describing the CLB tool configuration.</data></node>
<node id="clb_counter"><data key="label">Ctr32</data><data key="type">Component</data><data key="description">32-bit counter (three per tile).</data></node>
<node id="clb_encoder_examples"><data key="label">CLB encoder examples</data><data key="type">Software</data><data key="description">CLB encoder examples located in the MotorControl SDK.</data></node>
<node id="clb_examples"><data key="label">C2000Ware CLB examples</data><data key="type">Software</data><data key="description">15 CLB examples in the latest C2000Ware revision.</data></node>
<node id="clb_fsm"><data key="label">FSM</data><data key="type">Component</data><data key="description">4-state finite state machine (three per tile).</data></node>
<node id="clb_hlc"><data key="label">HLC</data><data key="type">Component</data><data key="description">High-level controller (one per tile).</data></node>
<node id="clb_lut4"><data key="label">LUT4</data><data key="type">Component</data><data key="description">4-input look-up table (three per tile).</data></node>
<node id="clb_output_lut"><data key="label">L3 output LUT</data><data key="type">Component</data><data key="description">3-input output look-up table (eight per tile).</data></node>
<node id="clb_tile"><data key="label">CLB tile</data><data key="type">Component</data><data key="description">CLB tile containing an optimized group of programmable logic cell blocks.</data></node>
<node id="clb_tool"><data key="label">CLB configuration tool</data><data key="type">Software</data><data key="description">Graphical CLB configuration tool integrated into Code Composer Studio; build output is a *.h header describing the CLB configuration.</data></node>
<node id="cmd_can_en"><data key="label">CMD_CAN_EN</data><data key="type">Parameter</data><data key="description">Pre-defined project symbol enabling CAN; S4 switch routes CAN GPIOs to J14.</data></node>
<node id="cmd_pot_en"><data key="label">CMD_POT_EN</data><data key="type">Parameter</data><data key="description">Pre-define symbol enabling potentiometer speed control.</data></node>
<node id="cmd_switch_control"><data key="label">Push button / command switch control</data><data key="type">Feature</data><data key="description">GPIO button (e.g. GPIO23) to start/stop the motor, enabled by CMD_SWITCH_EN.</data></node>
<node id="cmd_switch_en"><data key="label">CMD_SWITCH_EN</data><data key="type">Parameter</data><data key="description">Pre-define symbol enabling push button start/stop.</data></node>
<node id="cmpss"><data key="label">CMPSS</data><data key="type">Peripheral</data><data key="description">Comparator subsystem used for phase-current overcurrent monitoring; a DAC sets the threshold and the CMPSS output trips.</data></node>
<node id="code_composer_studio"><data key="label">Code Composer Studio</data><data key="type">Software</data><data key="description">TI integrated development environment supporting TI's microcontroller and embedded processor portfolio; a suite of tools to develop and debug embedded applications.</data></node>
<node id="communication_c"><data key="label">communication.c</data><data key="type">Software</data><data key="description">Defines HAL_setupCANA, canaISR, initCANCOM, updateCANCmdFreq; prototypes in communication.h.</data></node>
<node id="compressor"><data key="label">Compressor and fan motors</data><data key="type">Application</data><data key="description">Current/voltage scale and voltage filter pole calculation for compressor and fan motor control.</data></node>
<node id="connectivity_manager"><data key="label">Connectivity Manager</data><data key="type">Component</data><data key="description">Arm Cortex-M4-based subsystem in F2838x that offloads processing-intensive communications; included in all F2838x devices.</data></node>
<node id="constant_power_region"><data key="label">Constant power region</data><data key="type">Concept</data><data key="description">IPMSM region II where field weakening must be employed, torque capacity reduced.</data></node>
<node id="constant_torque_region"><data key="label">Constant torque region</data><data key="type">Concept</data><data key="description">IPMSM region I where MTPA ensures maximum torque generation.</data></node>
<node id="constant_voltage_region"><data key="label">Constant voltage region</data><data key="type">Concept</data><data key="description">IPMSM region III where deep field weakening keeps constant stator voltage.</data></node>
<node id="controlsuite"><data key="label">controlSUITE</data><data key="type">Software</data><data key="description">Earlier TI software suite through which DesignDRIVE was released and updated.</data></node>
<node id="cpu_timer"><data key="label">CPU Timer</data><data key="type">Peripheral</data><data key="description">32-bit CPU timer.</data></node>
<node id="csd18536kt"><data key="label">CSD18536KT</data><data key="type">Component</data><data key="description">NexFET MOSFET on DRV8329AEVM (Table 3-1 lists CSD18536KTTT).</data></node>
<node id="csd19532q5b"><data key="label">CSD19532Q5B</data><data key="type">Component</data><data key="description">NexFET power block used on DRV8353RS-EVM.</data></node>
<node id="csd88599q5dc"><data key="label">CSD88599Q5DC</data><data key="type">Component</data><data key="description">NexFET power block used on BOOSTXL-DRV8323RH/RS.</data></node>
<node id="current_limit"><data key="label">Current limit circle</data><data key="type">Concept</data><data key="description">sqrt(id^2+iq^2) &lt;= Imax (Eq 29), circle of radius Imax in d-q plane.</data></node>
<node id="current_loop_auto_tuning"><data key="label">Automatic current-loop tuning</data><data key="type">Feature</data><data key="description">Automatic tuning of current loop in InstaSPIN-FOC.</data></node>
<node id="current_model"><data key="label">Current model</data><data key="type">Algorithm</data><data key="description">Basic method to calculate rotor flux angle in asynchronous machines using two motor model equations in d-q frame.</data></node>
<node id="current_pi_controller"><data key="label">Id/Iq current PI controllers</data><data key="type">Algorithm</data><data key="description">Current regulators comparing isd/isq with isdref/isqref; outputs Vsdref and Vsqref fed to inverse Park.</data></node>
<node id="current_reconstruction"><data key="label">Current reconstruction</data><data key="type">Algorithm</data><data key="description">Step in the main ISR reconstructing phase currents after ADC offset removal.</data></node>
<node id="current_scale_value"><data key="label">Current scale value</data><data key="type">Parameter</data><data key="description">Hardware-dependent parameter that must be set correctly to identify and run the motor with FOC.</data></node>
<node id="current_sense_amplifier"><data key="label">Current sense amplifier</data><data key="type">Component</data><data key="description">Amplifier whose output is compared against the CMPSS DAC threshold for overcurrent trip.</data></node>
<node id="custom_board"><data key="label">Custom motor driver board</data><data key="type">Component</data><data key="description">User-designed application board to drive a motor; requires correct MCU/gate-driver power and JTAG connectivity before migrating the reference code.</data></node>
<node id="d_axis_current"><data key="label">d-axis current (id)</data><data key="type">Concept</data><data key="description">Flux component of stator current; set to zero for PMSM, negative for field weakening, computed by MTPA for IPMSM.</data></node>
<node id="d_axis_inductance"><data key="label">d-axis inductance (Ld)</data><data key="type">Concept</data><data key="description">d-axis inductance; varies with id and saturation.</data></node>
<node id="dac"><data key="label">DAC</data><data key="type">Peripheral</data><data key="description">12-bit DAC in each CMPSS that sets the high/low overcurrent thresholds, referenced to VDDA.</data></node>
<node id="dac128s085_h"><data key="label">dac128s085.h</data><data key="type">Software</data><data key="description">DAC128S085 driver header defining DAC_EN_CH_NUM.</data></node>
<node id="dac128s085evm"><data key="label">DAC128S085EVM</data><data key="type">EvaluationKit</data><data key="description">Optional DAC board on LaunchPad site 2 (J5-J8) used only for debugging to monitor software variables; requires bending J5-42 and JA-2 to JB-2 jumper.</data></node>
<node id="dac128s_module"><data key="label">DAC128S module</data><data key="type">Software</data><data key="description">Converts up to 8 software variables to 12-bit values and sends them over SPI to the DAC128S085EVM.</data></node>
<node id="dac128s_ptrdata"><data key="label">dac128s.ptrData[0..7]</data><data key="type">Parameter</data><data key="description">DAC128S module inputs pointing to variables (angles, currents, voltages), with gain[] and offset[]; set in sys_main.c by build level.</data></node>
<node id="dac128s_writedata"><data key="label">DAC128S_writeData</data><data key="type">Software</data><data key="description">Converts and sends software variables to external DAC with SPI.</data></node>
<node id="dac_128s_enable"><data key="label">DAC_128S_ENABLE</data><data key="type">Parameter</data><data key="description">Enables external DAC128S functionality (written DAC128S_ENABLE in Table 3-4).</data></node>
<node id="dac_en_ch_num"><data key="label">DAC_EN_CH_NUM</data><data key="type">Parameter</data><data key="description">Define in dac128s085.h setting number of DAC128S outputs (1-8); default 4.</data></node>
<node id="data_log_scale_factor"><data key="label">DATA_LOG_SCALE_FACTOR</data><data key="type">Parameter</data><data key="description">Datalog prescaler define in datalogIF.h; default 10 (logs one of every N samples).</data></node>
<node id="datalog"><data key="label">DATALOG library</data><data key="type">Software</data><data key="description">Module storing real-time values of two user-selectable variables in C2000 data RAM via DMA for display with the graph tool.</data></node>
<node id="datalogbuff1"><data key="label">datalogBuff1</data><data key="type">Parameter</data><data key="description">Datalog RAM buffer arrays (with datalogBuff2) holding logged data for display.</data></node>
<node id="datalogf2_en"><data key="label">DATALOGF2_EN</data><data key="type">Parameter</data><data key="description">Enables Datalog with graph tool; requires DMA.</data></node>
<node id="datalogif_c"><data key="label">datalogIF.c</data><data key="type">Software</data><data key="description">Datalog interface source declaring DATALOG_Obj datalog and handle.</data></node>
<node id="datalogif_h"><data key="label">datalogIF.h</data><data key="type">Software</data><data key="description">Datalog interface header defining DATA_LOG_SCALE_FACTOR.</data></node>
<node id="datalogif_update"><data key="label">DATALOGIF_update</data><data key="type">Software</data><data key="description">Stores real-time values for displaying with graph tool.</data></node>
<node id="datalogobj_iptr"><data key="label">datalogObj-&gt;iptr[0..1]</data><data key="type">Parameter</data><data key="description">Datalog module inputs pointed to addresses of the two logged variables; set in sys_main.c and vary by build level.</data></node>
<node id="dc_bus_voltage"><data key="label">DC bus voltage (Vbus)</data><data key="type">Concept</data><data key="description">Sampled DC link voltage; limits maximum inverter output voltage.</data></node>
<node id="dc_bus_voltage_protection"><data key="label">DC bus over/under-voltage protection</data><data key="type">Concept</data><data key="description">Fault when DC bus voltage leaves user-defined range, with hysteresis norm thresholds.</data></node>
<node id="dc_motor"><data key="label">DC motor</data><data key="type">Motor</data><data key="description">Stator and rotor excitation are independently controlled so torque and flux can be tuned independently; commutator keeps rotor flux orthogonal to stator field.</data></node>
<node id="dcc"><data key="label">DCC</data><data key="type">Peripheral</data><data key="description">Dual-clock comparator for missing clock detection.</data></node>
<node id="dcsm"><data key="label">DCSM</data><data key="type">Peripheral</data><data key="description">Dual-code security module.</data></node>
<node id="dead_time"><data key="label">Dead band</data><data key="type">Concept</data><data key="description">ePWM dead-band rising/falling edge delays set by MTR1_PWM_DBRED_CNT/DBFED_CNT; active-high complementary.</data></node>
<node id="designdrive"><data key="label">DesignDRIVE</data><data key="type">Software</data><data key="description">Sensored FOC solutions using DesignDRIVE components: multiple current-sense topologies, analog/digital position sensor interfaces, control techniques, real-time connectivity; released via controlSUITE, now in MotorControl SDK.</data></node>
<node id="designdrive_kit"><data key="label">C2000 DesignDRIVE development kit</data><data key="type">EvaluationKit</data><data key="description">C2000 DesignDRIVE development kit for industrial motor control.</data></node>
<node id="device_c_h"><data key="label">device.c / device.h</data><data key="type">Software</data><data key="description">C2000Ware device driver files with pin definitions and DEVICE_SYSCLK_FREQ; replaced for the new device.</data></node>
<node id="digital_motor_control_library"><data key="label">Digital motor control library</data><data key="type">Software</data><data key="description">Earlier TI motor control library.</data></node>
<node id="digital_power"><data key="label">Digital power control</data><data key="type">Application</data><data key="description"></data></node>
<node id="digitalpower_sdk"><data key="label">C2000Ware DigitalPower SDK</data><data key="type">Software</data><data key="description">DigitalPower software development kit for C2000 MCUs.</data></node>
<node id="dimm100"><data key="label">DIMM100 connector</data><data key="type">Component</data><data key="description">100-pin DIMM controlCARD socket used by existing evaluation tools such as TMDSHVMTRINSPIN.</data></node>
<node id="dma"><data key="label">DMA</data><data key="type">Peripheral</data><data key="description">Direct Memory Access; used to transfer selected variables to the datalog buffers in RAM.</data></node>
<node id="dmc_buildlevel"><data key="label">DMC_BUILDLEVEL</data><data key="type">Parameter</data><data key="description">Define in sys_settings.h selecting DMC_LEVEL_1..DMC_LEVEL_4; rebuild project after change.</data></node>
<node id="dq_reference_frame"><data key="label">d-q rotating reference frame</data><data key="type">Concept</data><data key="description">Rotor reference frame aligned with rotor flux in which currents become DC quantities.</data></node>
<node id="driverlib"><data key="label">C2000Ware DriverLib</data><data key="type">Software</data><data key="description">C2000Ware driver library; e.g. can.c is linked to add CAN; driverlib APIs differ slightly between devices.</data></node>
<node id="drv8316"><data key="label">DRV8316</data><data key="type">Component</data><data key="description">BLDC motor driver supported by HAL_setupSPI/HAL_setupGate/HAL_enableDRV code paths.</data></node>
<node id="drv8316revm"><data key="label">DRV8316REVM</data><data key="type">EvaluationKit</data><data key="description">Three half-H-bridge integrated MOSFET driver board for three-phase BLDC motors, 8-A peak, with integrated CSAs and voltage sensing.</data></node>
<node id="drv8323rh"><data key="label">DRV8323RH</data><data key="type">Component</data><data key="description">Hardware-interface DRV8323 variant; single-phase current sensing CMPSS defines apply to DRV8323RH and RS only.</data></node>
<node id="drv8323rs"><data key="label">DRV8323RS</data><data key="type">Component</data><data key="description">SPI BLDC motor gate driver used as the example for supporting a new BLDC motor driver; driver files drv8323s.h/.c.</data></node>
<node id="drv8323s_driver_files"><data key="label">drv8323s.h / drv8323s.c</data><data key="type">Software</data><data key="description">Existing DRV8323 SPI driver files under libraries/drvic/drv8323, used as reference for new drivers.</data></node>
<node id="drv8329a"><data key="label">DRV8329A</data><data key="type">Component</data><data key="description">Gate driver on DRV8329AEVM.</data></node>
<node id="drv8329aevm"><data key="label">DRV8329AEVM</data><data key="type">EvaluationKit</data><data key="description">4.5-60V, 30-A three-phase BLDC drive stage based on DRV8329A gate driver and CSD18536KT MOSFET, with DC bus/three-phase voltage sensing and single-shunt dc-link current amplifiers.</data></node>
<node id="drv8353"><data key="label">DRV8353</data><data key="type">Component</data><data key="description">BLDC motor driver supported by HAL_setupSPI/HAL_setupGate/HAL_enableDRV code paths.</data></node>
<node id="drv8353rs"><data key="label">DRV8353RS</data><data key="type">Component</data><data key="description">SPI-configurable gate driver on DRV8353RS-EVM.</data></node>
<node id="drv8353rs_evm"><data key="label">DRV8353RS-EVM</data><data key="type">EvaluationKit</data><data key="description">15-A three-phase BLDC drive stage based on DRV8353RS gate driver and CSD19532Q5B NexFET power blocks, with three low-side current shunt amplifiers and SPI-configurable protection.</data></node>
<node id="drv83xx_c"><data key="label">drv83xx.c</data><data key="type">Software</data><data key="description">Inverter gate driver file.</data></node>
<node id="drv_add_header_include"><data key="label">Add driver header include</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 3: Include drv8323s.h in hal_obj.h and add include path.</data></node>
<node id="drv_add_source_files"><data key="label">Add BLDC driver source files to project</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 2: Link driver files via projectspec &lt;file action=link&gt; or CCS Add Files.</data></node>
<node id="drv_call_driver_functions"><data key="label">Call driver functions in motor1_drive.c</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 8: Call HAL_enableDRV() and HAL_setupDRVSPI() in motor1_drive.c.</data></node>
<node id="drv_call_setup_functions"><data key="label">Call HAL_setupSPI and HAL_setupGate</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 7: Call HAL_setupSPI() and HAL_setupGate() in HAL_MTR_setParams().</data></node>
<node id="drv_change_default_settings"><data key="label">Change BLDC driver default settings</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 9: Set drvicVars_M1 control register fields and write with HAL_writeDRVData().</data></node>
<node id="drv_configure_gpios"><data key="label">Configure ENABLE and nFAULT GPIOs</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 6: Define MTR1_GATE_EN_GPIO and MTR1_PM_nFAULT_GPIO; see HAL_setupGPIOs(), HAL_setupGate().</data></node>
<node id="drv_configure_spi"><data key="label">Configure SPI for BLDC driver</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 5: Configure SPI GPIOs and SPI baud rate/data frame in HAL_setupSPI().</data></node>
<node id="drv_design_driver_file"><data key="label">Design driver file for new BLDC driver</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 1: Adapt drv8323s.h/.c registers and APIs into drv8xxx.h/.c; create libraries/drvic folders.</data></node>
<node id="drv_edit_hal_obj"><data key="label">Add drvic and SPI handles to HAL_Obj</data><data key="type">Feature</data><data key="description">New BLDC motor driver support step 4: Map DRVIC_* defines to DRV8323_* and add spiHandle, drvicHandle, drvic, gateEnableGPIO.</data></node>
<node id="drvicvars_m1"><data key="label">drvicVars_M1</data><data key="type">Parameter</data><data key="description">BLDC driver register variables; defaults set e.g. VDS_LVL 1.7V, OCP automatic retry, DEAD_TIME 100ns, CSA_GAIN 10V/V.</data></node>
<node id="dual_estimator"><data key="label">Simultaneous dual estimators</data><data key="type">Feature</data><data key="description">Two FOC algorithms can be used simultaneously (FAST+eSMO, FAST+ENC, FAST+HALL, eSMO+ENC) and switched smoothly on the fly; ISBLDC cannot be combined.</data></node>
<node id="ecap"><data key="label">eCAP</data><data key="type">Peripheral</data><data key="description">Enhanced capture module.</data></node>
<node id="eemf"><data key="label">Extended EMF (EEMF)</data><data key="type">Concept</data><data key="description">Extended electromotive force in alpha-beta axes, the only term containing rotor position information; e = [lambda_pm + (Ld-Lq) id] we [-sin th; cos th] (Eq 3); magnitude E = we*lambda_pm.</data></node>
<node id="electromagnetic_torque"><data key="label">Electromagnetic torque (Te)</data><data key="type">Concept</data><data key="description">Te = 3/2 p [psi_m iq + (Ld-Lq) id iq] (Eq 28): mutual (magnet) torque plus reluctance torque.</data></node>
<node id="enable_fs"><data key="label">Enable_FS</data><data key="type">Parameter</data><data key="description">Flag enabling the flying start module.</data></node>
<node id="enc_module"><data key="label">ENC module</data><data key="type">Software</data><data key="description">Lab module converting encoder signal into an angle; requires slots per rotation.</data></node>
<node id="enc_run"><data key="label">ENC_run</data><data key="type">Software</data><data key="description">Calculates rotor angle based on encoder.</data></node>
<node id="encoder"><data key="label">Encoder</data><data key="type">Concept</data><data key="description">QEP encoder; A-A, B-B, I-I wiring required, often +5V and ground.</data></node>
<node id="entry_performance_line"><data key="label">C2000 Entry-Performance line</data><data key="type">Concept</data><data key="description">C2000 MCUs with up to 150 MIPS real-time control performance; new focus on application-tailored series.</data></node>
<node id="epwm"><data key="label">ePWM</data><data key="type">Peripheral</data><data key="description">Generates the inverter PWM signals (EPWM1/2/3 or 6 for U/V/W), triggers ADC SOC, and provides trip-zone shutdown on faults.</data></node>
<node id="epwm_trip_zone"><data key="label">ePWM trip zone</data><data key="type">Concept</data><data key="description">ePWM trip-zone submodule; DCAEVT1/DCBEVT1 one-shot trips force EPWMxA/B low.</data></node>
<node id="epwmdac_mode"><data key="label">EPWMDAC_MODE</data><data key="type">Parameter</data><data key="description">Enables PWMDAC function; supported only on TMDSHVMTRINSPIN.</data></node>
<node id="eqep"><data key="label">eQEP</data><data key="type">Peripheral</data><data key="description">Enhanced QEP; eQEP1 used for encoder interface J12, eQEP2 for Hall sensor interface J13.</data></node>
<node id="erad"><data key="label">ERAD</data><data key="type">Peripheral</data><data key="description">Embedded real-time analysis and diagnostic.</data></node>
<node id="esmo"><data key="label">eSMO</data><data key="type">Algorithm</data><data key="description">Observer based on sliding mode control; structure purposefully changed by system state to follow a sliding trajectory; fast response, robust, insensitive to parameter changes and disturbances. Traditional reduced-order SMO uses a motor-model current observer, bang-bang control, LPF and angle calculator.</data></node>
<node id="esmo_run"><data key="label">ESMO_run</data><data key="type">Software</data><data key="description">Enhanced Sliding Mode Observer for sensorless FOC.</data></node>
<node id="essential_guide_c2000"><data key="label">The Essential Guide for Developing With C2000 Real-Time Microcontrollers</data><data key="type">Document</data><data key="description">TI reference document.</data></node>
<node id="est_run"><data key="label">EST_run</data><data key="type">Parameter</data><data key="description">Function call running the FAST estimator in the ISR.</data></node>
<node id="est_runtraj"><data key="label">EST_runTraj</data><data key="type">Software</data><data key="description">Trajectory generator for current and speed for motor identification (FAST).</data></node>
<node id="est_setuptrajstate"><data key="label">EST_setupTrajState</data><data key="type">Software</data><data key="description">Trajectory generator setup for current and speed for motor identification (FAST).</data></node>
<node id="ethercat"><data key="label">EtherCAT</data><data key="type">Peripheral</data><data key="description">Integrated EtherCAT slave capability.</data></node>
<node id="ethernet"><data key="label">Ethernet</data><data key="type">Peripheral</data><data key="description">10/100 Ethernet.</data></node>
<node id="euler_method"><data key="label">Euler discretization</data><data key="type">Algorithm</data><data key="description">Used to transform the SMO into a time-discrete observer for digital control.</data></node>
<node id="f2800137"><data key="label">F2800137</data><data key="type">Device</data><data key="description">TMS320F2800137 device of the F280013x series, with product folder, LaunchPad and controlCARD evaluation modules.</data></node>
<node id="f280013x"><data key="label">F280013x</data><data key="type">Device</data><data key="description">TMS320F280013x series in the Entry-Performance line of C2000 real-time MCUs, built for efficient control of power electronics; extension of the Generation 3 C2000 MCU portfolio.</data></node>
<node id="f280025c"><data key="label">F280025C</data><data key="type">Device</data><data key="description">C2000 MCU on the LAUNCHXL-F280025C used as the reference/source device in the porting example.</data></node>
<node id="f28002x"><data key="label">F28002x</data><data key="type">Device</data><data key="description">Device family of the source lab folder 'f28002x'; supports Fast Integer Division (FINTDIV) and has no PGA.</data></node>
<node id="f28002x_flash_lib_is_cmd"><data key="label">f28002x_flash_lib_is.cmd</data><data key="type">Software</data><data key="description">Linker command file mapping MCU memory; renamed and adapted for the new device.</data></node>
<node id="f28002x_trm"><data key="label">TMS320F28002x Real-Time Microcontrollers Technical Reference Manual</data><data key="type">Document</data><data key="description">TRM (Rev. A) with Analog Pins and Internal Connections table and ePWM/OUTPUT X-BAR mux configuration tables.</data></node>
<node id="f280039c"><data key="label">F280039C</data><data key="type">Device</data><data key="description">C2000 MCU (U1) on LAUNCHXL-F280039C and TMDSCNCD280039C.</data></node>
<node id="f28003x"><data key="label">F28003x</data><data key="type">Device</data><data key="description">Device family whose LaunchPad and controlCARD support was added in Rev. A.</data></node>
<node id="f280049c"><data key="label">F280049C</data><data key="type">Device</data><data key="description">F28004x device whose target configuration name (TMS320F280049C) is used for all F28004x devices; has separate CMPSS modules for each phase current input.</data></node>
<node id="f28004x"><data key="label">F28004x</data><data key="type">Device</data><data key="description">Example new target C2000 MCU for porting; does not support FINTDIV but has a Programmable Gain Amplifier (PGA).</data></node>
<node id="f28004x_headers_nonbios_cmd"><data key="label">f28004x_headers_nonbios.cmd</data><data key="type">Software</data><data key="description">Header cmd file used only by the debug watch window; may be reported missing on import.</data></node>
<node id="f2802x"><data key="label">F2802x</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (Entry-Performance).</data></node>
<node id="f2803x"><data key="label">F2803x</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (Entry-Performance).</data></node>
<node id="f2805x"><data key="label">F2805x</data><data key="type">Device</data><data key="description">C2000 series with on-chip InstaSPIN-FOC ROM library.</data></node>
<node id="f2806x"><data key="label">F2806x</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (Mid-Performance).</data></node>
<node id="f28076"><data key="label">F28076</data><data key="type">Device</data><data key="description">TMS320F28076 device supported by the MotorControl SDK.</data></node>
<node id="f2807x"><data key="label">F2807x</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (Mid-Performance).</data></node>
<node id="f2833x"><data key="label">F2833x</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (Entry/Mid (Gen 2)).</data></node>
<node id="f28379d"><data key="label">F28379D</data><data key="type">Device</data><data key="description">TMS320F28379D device supported by the MotorControl SDK.</data></node>
<node id="f2837x"><data key="label">F2837x</data><data key="type">Device</data><data key="description">C2000 series; F2838x is described as an F2837x device with performance enhancements and a connectivity manager.</data></node>
<node id="f2837xd"><data key="label">F2837xD</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (High-Performance).</data></node>
<node id="f2837xs"><data key="label">F2837xS</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (Mid-Performance).</data></node>
<node id="f28388d"><data key="label">F28388D</data><data key="type">Device</data><data key="description">TMS320F28388D device of the F2838x series.</data></node>
<node id="f2838x"><data key="label">F2838x</data><data key="type">Device</data><data key="description">C2000 real-time controller series: an F2837x device with performance enhancements and an Arm Cortex-M4 based connectivity manager; near single-chip solution for connected drives and industrial power.</data></node>
<node id="f2838xd"><data key="label">F2838xD</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (High-Performance).</data></node>
<node id="f2838xs"><data key="label">F2838xS</data><data key="type">Device</data><data key="description">C2000 MCU series in the portfolio figure (Mid-Performance).</data></node>
<node id="factory_automation"><data key="label">Factory automation</data><data key="type">Application</data><data key="description"></data></node>
<node id="fast_current_loop"><data key="label">Fast Current Loop (FCL)</data><data key="type">Software</data><data key="description">Optimized software library processing the servo drive FOC current loop (&lt; 500 ns on F2838x; full FOC torque loop &lt; 1 us) using hardware accelerators and cycle-scavenging.</data></node>
<node id="fast_estimator"><data key="label">FAST Software Encoder</data><data key="type">Algorithm</data><data key="description">FAST library estimates motor Flux, Angle, Speed and Torque; requires FPU-enabled C2000 devices supported by C2000Ware-MotorControl-SDK. Called via EST_run in the FOC ISR.</data></node>
<node id="fault_protection"><data key="label">Fault protection</data><data key="type">Concept</data><data key="description">On driver nFAULT or CMPSS overcurrent, ePWM X-BAR and trip zones force PWM outputs low.</data></node>
<node id="field_weakening"><data key="label">Field weakening</data><data key="type">Algorithm</data><data key="description">Weakens air-gap flux via negative id (d-axis armature reaction) to run above base speed; FW PI controller on voltage magnitude error outputs beta_fw, saturated at 0 until voltage limit reached.</data></node>
<node id="fintdiv"><data key="label">Fast Integer Division (FINTDIV)</data><data key="type">Feature</data><data key="description">F28002x capability enabled via --idiv_support=idiv0; must be removed from projectspec for F28004x.</data></node>
<node id="flagenableoffsetcalc"><data key="label">flagEnableOffsetCalc</data><data key="type">Parameter</data><data key="description">Flag enabling automatic ADC offset calibration.</data></node>
<node id="flying_start"><data key="label">Flying start</data><data key="type">Feature</data><data key="description">Determines speed and direction of a spinning motor and starts output at that speed; applies zero torque current, estimates position/speed, then enables speed closed loop.</data></node>
<node id="foc"><data key="label">Field-oriented control (FOC)</data><data key="type">Algorithm</data><data key="description">Field Oriented Control (rotor flux oriented / vector control): decouples torque and magnetizing flux components of stator current via Clarke and Park transforms into a time-invariant d-q system, similar to DC machine control.</data></node>
<node id="force_angle_startup"><data key="label">Force angle startup</data><data key="type">Feature</data><data key="description">Startup option using a forced angle frequency (typ. +-1 Hz) near zero speed.</data></node>
<node id="fpga_cpld"><data key="label">FPGA/CPLD</data><data key="type">Component</data><data key="description">External programmable logic whose typical functions F2838x capabilities replace.</data></node>
<node id="fpu"><data key="label">FPU</data><data key="type">Peripheral</data><data key="description">Floating-point unit; FAST observer for InstaSPIN-FOC requires FPU enabled.</data></node>
<node id="fpu64"><data key="label">64-bit FPU</data><data key="type">Peripheral</data><data key="description">64-bit floating-point unit for extended precision.</data></node>
<node id="freertos"><data key="label">FreeRTOS</data><data key="type">Software</data><data key="description">Real-time OS configurable through C2000 SysConfig.</data></node>
<node id="fsi"><data key="label">FSI</data><data key="type">Peripheral</data><data key="description">FSI header J1 on controlCARDs.</data></node>
<node id="fw_mtpa_switching_control"><data key="label">FW/MTPA switching control</data><data key="type">Algorithm</data><data key="description">Decides which current angle to apply: beta = beta_fw if beta_fw &gt; beta_mtpa, else beta_mtpa; then computes id/iq references from Is_ref.</data></node>
<node id="gan_fet"><data key="label">GaN power stage</data><data key="type">Component</data><data key="description">Three-phase GaN inverter power stage on BOOSTXL-3PHGANINV.</data></node>
<node id="generic_flash_lnk_cmd"><data key="label">28004x_generic_flash_lnk.cmd</data><data key="type">Software</data><data key="description">Generic C2000Ware cmd file that may be easier to adapt than the old device's cmd.</data></node>
<node id="getting_started_c2000_mcus"><data key="label">Getting Started With C2000 Real-Time Control Microcontrollers (MCUs)</data><data key="type">Document</data><data key="description">TI reference document.</data></node>
<node id="gmtpa"><data key="label">Gmtpa</data><data key="type">Parameter</data><data key="description">Intermediate MTPA variable computed in the ISR.</data></node>
<node id="gpio"><data key="label">GPIO</data><data key="type">Peripheral</data><data key="description">Pins configured in HAL_setupGPIOs() for PWM outputs, SPI, CAN, buttons, enable and nFAULT.</data></node>
<node id="grid"><data key="label">High-power grid</data><data key="type">Application</data><data key="description"></data></node>
<node id="gui_composer"><data key="label">GUI Composer</data><data key="type">Software</data><data key="description">TI tool into which the InstaSPIN Universal GUI can be imported and customized.</data></node>
<node id="gui_quick_start_guide"><data key="label">GUI Quick Start Guide</data><data key="type">Document</data><data key="description">gui_quick_start_guide.pdf at &lt;SDK install&gt;/solutions/common/sensorless_foc/docs.</data></node>
<node id="hal_c"><data key="label">hal.c</data><data key="type">Software</data><data key="description">Board-specific hardware abstraction layer drivers; with hal.h, the files to change when migrating to a custom board or other C2000 device.</data></node>
<node id="hal_enablecanints"><data key="label">HAL_enableCANInts()</data><data key="type">Parameter</data><data key="description">Enables CAN interrupts, PIE INT_CANA0 and CPU INT9.</data></node>
<node id="hal_enablectrlints"><data key="label">HAL_enableCtrlInts()</data><data key="type">Parameter</data><data key="description">Configures MCU interrupts with HAL_initIntVectorTable, HAL_enableGlobalInts, HAL_enableDebugInt before the forever loop.</data></node>
<node id="hal_enabledrv"><data key="label">HAL_enableDRV()</data><data key="type">Parameter</data><data key="description">Turns on the DRV8323/DRV8353/DRV8316 if present; called in motor1_drive.c.</data></node>
<node id="hal_h"><data key="label">hal.h</data><data key="type">Software</data><data key="description">HAL header defining PWM/ADC/CMPSS bases, channels, SOCs, X-BAR muxes, fault and GPIO numbers.</data></node>
<node id="hal_init"><data key="label">HAL_init()</data><data key="type">Parameter</data><data key="description">Initializes the HAL handle; called in sys_main.c, defined in hal.c; also initializes CAN handle when added.</data></node>
<node id="hal_mtr_setparams"><data key="label">HAL_MTR_setParams()</data><data key="type">Parameter</data><data key="description">Sets up HAL with user parameters; calls HAL_setupSPI() and HAL_setupGate() for SPI drivers.</data></node>
<node id="hal_obj_h"><data key="label">hal_obj.h</data><data key="type">Software</data><data key="description">Defines HAL_Obj structure; extended with canHandle, spiHandle and drvic handles.</data></node>
<node id="hal_readadcdata"><data key="label">HAL_readAdcData</data><data key="type">Parameter</data><data key="description">Returns ADC conversion values in floating-point format.</data></node>
<node id="hal_readmtr1adcdata"><data key="label">HAL_readMtr1ADCData()</data><data key="type">Parameter</data><data key="description">Reads ADC results (e.g. potAdc) into HAL_ADCData_t; added channels need code here.</data></node>
<node id="hal_setupadcs"><data key="label">HAL_setupADCs()</data><data key="type">Parameter</data><data key="description">hal.c function setting up ADC SOCs, e.g. ADC_setupSOC for the potentiometer.</data></node>
<node id="hal_setupcana"><data key="label">HAL_setupCANA()</data><data key="type">Parameter</data><data key="description">communication.c function initializing CANA, bit rate and TX/RX message objects.</data></node>
<node id="hal_setupcmpsss"><data key="label">HAL_setupCMPSSs()</data><data key="type">Parameter</data><data key="description">hal.c function enabling CMPSS, DAC-sourced comparator inputs, digital filters (32,32,30), hysteresis and DAC high/low thresholds.</data></node>
<node id="hal_setupdrvspi"><data key="label">HAL_setupDRVSPI()</data><data key="type">Parameter</data><data key="description">Initializes the DRV8323/DRV8353/DRV8316 SPI interface.</data></node>
<node id="hal_setupfaults"><data key="label">HAL_setupFaults()</data><data key="type">Parameter</data><data key="description">Sets up faults depending on the board used; with HAL_disablePWM().</data></node>
<node id="hal_setupgate"><data key="label">HAL_setupGate()</data><data key="type">Parameter</data><data key="description">hal.c function setting up the drv8323s/drv8353s/drv8316s interface.</data></node>
<node id="hal_setupgpios"><data key="label">HAL_setupGPIOs()</data><data key="type">Parameter</data><data key="description">hal.c function configuring GPIO pin function, direction and pad config per the motor driver board.</data></node>
<node id="hal_setupmtrfaults"><data key="label">HAL_setupMtrFaults()</data><data key="type">Parameter</data><data key="description">hal.c function configuring ePWM X-BAR TRIP7, Input X-BAR for nFAULT, and trip-zone DC events forcing PWM low.</data></node>
<node id="hal_setuppwms"><data key="label">HAL_setupPWMs()</data><data key="type">Parameter</data><data key="description">hal.c function configuring ePWM counter mode (up-down), action qualifiers, dead band, ISR and ADC SOC trigger.</data></node>
<node id="hal_setupspi"><data key="label">HAL_setupSPI()</data><data key="type">Parameter</data><data key="description">hal.c function configuring SPI (POL0PHA0, master, 400000 baud, 16-bit, FIFO) for the BLDC driver.</data></node>
<node id="hal_writepwmdacdata"><data key="label">HAL_writePWMDACData</data><data key="type">Software</data><data key="description">Converts software variables into PWM signals.</data></node>
<node id="hal_writepwmdata"><data key="label">HAL_writePwmData</data><data key="type">Parameter</data><data key="description">HAL function writing SVM outputs to the PWM driver.</data></node>
<node id="hall_cal"><data key="label">HALL_CAL</data><data key="type">Parameter</data><data key="description">Symbol for Hall sensor calibration in Hall sensored FOC.</data></node>
<node id="hall_enable"><data key="label">HALL_ENABLE</data><data key="type">Parameter</data><data key="description">Symbol for Hall sensor based sensored FOC.</data></node>
<node id="hall_run"><data key="label">HALL_run</data><data key="type">Software</data><data key="description">Calculates rotor angle and speed based on Hall sensors.</data></node>
<node id="hall_sensor"><data key="label">Hall sensor</data><data key="type">Concept</data><data key="description">Hall sensors used for sensored FOC (HALL_run).</data></node>
<node id="home_appliances"><data key="label">Home appliances</data><data key="type">Application</data><data key="description">PMSM widely used in home appliances; sensorless control avoids sensor cost.</data></node>
<node id="hrcap"><data key="label">HRCAP</data><data key="type">Peripheral</data><data key="description">High-resolution capture.</data></node>
<node id="hrpwm"><data key="label">HRPWM</data><data key="type">Peripheral</data><data key="description">High-resolution PWM.</data></node>
<node id="hsec180"><data key="label">HSEC180 connector</data><data key="type">Component</data><data key="description">180-pin High Speed Edge Connector of controlCARDs.</data></node>
<node id="hvac"><data key="label">HVAC</data><data key="type">Application</data><data key="description">Heating, ventilation and air conditioning.</data></node>
<node id="hvac_reference_design"><data key="label">HVAC Reference Design</data><data key="type">EvaluationKit</data><data key="description">HVAC reference design listed as an F280013x resource.</data></node>
<node id="hvbldcmtr"><data key="label">HVBLDCMTR</data><data key="type">Motor</data><data key="description">High-voltage BLDC motor with embedded Hall sensors; not supported for encoder-based sensored FOC.</data></node>
<node id="hvpmsmmtr"><data key="label">HVPMSMMTR</data><data key="type">Motor</data><data key="description">High-voltage PMSM with embedded encoder; tested with TMDSHVMTRINSPIN; not supported for Hall-based sensored FOC.</data></node>
<node id="hw_design_guidelines_f28xx"><data key="label">Hardware Design Guidelines for TMS320F28xx and TMS320F28xxx</data><data key="type">Document</data><data key="description">TI reference document.</data></node>
<node id="hwbist"><data key="label">HWBIST</data><data key="type">Peripheral</data><data key="description">Hardware built-in self-test.</data></node>
<node id="i2c"><data key="label">I2C</data><data key="type">Peripheral</data><data key="description">Inter-integrated circuit interface.</data></node>
<node id="if_control"><data key="label">I/f control</data><data key="type">Algorithm</data><data key="description">Current closed-loop control with the rotor angle from the ramp generator, used in build level 3.</data></node>
<node id="inductance_lut"><data key="label">Ld/Lq look-up table</data><data key="type">Algorithm</data><data key="description">Robust LUT method modeling Ld as a function of id and Lq as a function of iq, ensuring controllability under parameter variation.</data></node>
<node id="industrial_drives"><data key="label">Industrial drives</data><data key="type">Application</data><data key="description"></data></node>
<node id="industrial_machinery"><data key="label">Industrial machinery</data><data key="type">Application</data><data key="description">Industrial machinery up to hundreds of kilowatts.</data></node>
<node id="industrial_power"><data key="label">Industrial power</data><data key="type">Application</data><data key="description"></data></node>
<node id="industrial_power_equipment"><data key="label">Industrial power equipment</data><data key="type">Application</data><data key="description"></data></node>
<node id="initmotor1ctrlparameters"><data key="label">initMotor1CtrlParameters()</data><data key="type">Parameter</data><data key="description">Initializes motor control parameters; defined in motor1_drive.c.</data></node>
<node id="inline_shunt_current_sensing"><data key="label">In-line phase current shunt sensing</data><data key="type">Concept</data><data key="description">Three shunt-based in-line motor phase current sensing.</data></node>
<node id="instaspin_bldc"><data key="label">InstaSPIN-BLDC</data><data key="type">Software</data><data key="description">BLDC control option of the lab with its own open-loop ramp and integration-threshold parameters.</data></node>
<node id="instaspin_foc"><data key="label">InstaSPIN-FOC</data><data key="type">Software</data><data key="description">FAST observer is implemented with InstaSPIN-FOC in the lab; no longer requires a C2000 device with special ROM content. Uses measured stator voltage and current to estimate rotor position and speed during flying start.</data></node>
<node id="instaspin_foc_labs_f28004x"><data key="label">F28004x InstaSPIN-FOC labs</data><data key="type">Software</data><data key="description">InstaSPIN-FOC lab projects for F28004x located under solutions/boostxl_drv8320rs and solutions/tmdshvmtrinspin.</data></node>
<node id="instaspin_foc_rom_library"><data key="label">InstaSPIN-FOC ROM library</data><data key="type">Software</data><data key="description">On-chip ROM library enabling InstaSPIN-FOC; fixed-point on F2806x/F2805x/F2802x via MotorWare, rewritten in floating point for F28004x.</data></node>
<node id="integer_division_unit"><data key="label">Fast integer division hardware</data><data key="type">Peripheral</data><data key="description">Fast integer division hardware for efficient calculations.</data></node>
<node id="integrated_csa"><data key="label">Integrated current-sense amplifiers</data><data key="type">Concept</data><data key="description">CSAs integrated in the driver for three-phase low-side current measurement.</data></node>
<node id="intosc"><data key="label">INTOSC</data><data key="type">Peripheral</data><data key="description">Internal 10-MHz oscillator.</data></node>
<node id="inverse_park_transform"><data key="label">Inverse Park transform</data><data key="type">Algorithm</data><data key="description">Converts Vsdref, Vsqref from current regulators to Vsalpharef, Vsbetaref in the stationary frame; needs rotor flux position.</data></node>
<node id="inverter_protection"><data key="label">Inverter protection</data><data key="type">Concept</data><data key="description">Protection schemes for inverters.</data></node>
<node id="ipark_run"><data key="label">IPARK_run</data><data key="type">Software</data><data key="description">Inverse Park transformation.</data></node>
<node id="ipd"><data key="label">IPD</data><data key="type">Algorithm</data><data key="description">Initial position detection, run in the motor control ISR.</data></node>
<node id="ipm"><data key="label">IPM</data><data key="type">Component</data><data key="description">Intelligent power module on TMDSHVMTRINSPIN with heat sink and DC fan.</data></node>
<node id="ipmsm"><data key="label">IPMSM</data><data key="type">Motor</data><data key="description">Interior PMSM; has electromagnetic and reluctance torque due to large saliency ratio, total torque non-linear in rotor angle; MTPA used to optimize torque.</data></node>
<node id="irated"><data key="label">Irated</data><data key="type">Parameter</data><data key="description">Rated current input in FOC block diagrams.</data></node>
<node id="isrcount"><data key="label">ISRCount</data><data key="type">Parameter</data><data key="description">Increments continuously when TEST_ENABLE is defined.</data></node>
<node id="jtag_emulator"><data key="label">JTAG emulator</data><data key="type">Component</data><data key="description">Debug emulator that must connect successfully to a custom board.</data></node>
<node id="kmtpa"><data key="label">Kmtpa</data><data key="type">Parameter</data><data key="description">Motor-parameter-based MTPA constant computed in the background loop with updated Ld and Lq.</data></node>
<node id="launchxl_f2800137"><data key="label">TMS320F2800137 LaunchPad</data><data key="type">EvaluationKit</data><data key="description">Low-cost development board for F280013x devices; supports two BoosterPack plug-in modules.</data></node>
<node id="launchxl_f280025c"><data key="label">LAUNCHXL-F280025C</data><data key="type">EvaluationKit</data><data key="description">LaunchPad used with BOOSTXL-DRV8323RS as the example combination for PWM, ADC and CMPSS connections; only CMPSS1 and CMPSS3 are available for current sensing pins.</data></node>
<node id="launchxl_f280039c"><data key="label">LAUNCHXL-F280039C</data><data key="type">EvaluationKit</data><data key="description">Low-cost development board for F28003x devices; supports two BoosterPack plug-in modules.</data></node>
<node id="launchxl_f280049c"><data key="label">LAUNCHXL-F280049C</data><data key="type">EvaluationKit</data><data key="description">C2000 Piccolo MCU F280049C LaunchPad development kit; a new BoosterPack works with it for the InstaSPIN-FOC solution.</data></node>
<node id="lifestyle_audio"><data key="label">Lifestyle audio</data><data key="type">Application</data><data key="description">Harman lifestyle audio products using CLB to offload control logic (400 kHz loop).</data></node>
<node id="low_pass_filter"><data key="label">Low-pass filter (SMO)</data><data key="type">Algorithm</data><data key="description">Filters discontinuous switching signals z_alpha, z_beta to estimate EEMF; introduces phase delay compensated by delta_theta.</data></node>
<node id="lpf_cutoff_frequency"><data key="label">fc (LPF cutoff)</data><data key="type">Parameter</data><data key="description">Cutoff frequency of SMO LPF, selected according to stator current fundamental frequency.</data></node>
<node id="lvbldcmtr"><data key="label">LVBLDCMTR</data><data key="type">Motor</data><data key="description">Low-voltage BLDC motor with embedded Hall sensors; not supported for encoder-based sensored FOC.</data></node>
<node id="lvservomtr"><data key="label">LVSERVOMTR</data><data key="type">Motor</data><data key="description">Low-voltage servo motor supported by FAST, eSMO, encoder and Hall based FOC in Table 3-4.</data></node>
<node id="mcan"><data key="label">CAN FD</data><data key="type">Peripheral</data><data key="description">CAN with flexible data rate.</data></node>
<node id="medical_tools"><data key="label">Medical tools</data><data key="type">Application</data><data key="description">Sub-100-W medical tools.</data></node>
<node id="motor1_dclink_ss"><data key="label">MOTOR1_DCLINK_SS</data><data key="type">Parameter</data><data key="description">Enables single-shunt current sensing; supported only on DRV8329AEVM per Table 3-4.</data></node>
<node id="motor1_drive_c"><data key="label">motor1_drive.c</data><data key="type">Software</data><data key="description">Motor 1 drive file defining initMotor1CtrlParameters and runMotor1OffsetsCalculation and calling HAL_enableDRV/HAL_setupDRVSPI.</data></node>
<node id="motor1_enc"><data key="label">MOTOR1_ENC</data><data key="type">Parameter</data><data key="description">Enables QEP encoder based sensored FOC (with QEP_ENABLE).</data></node>
<node id="motor1_esmo"><data key="label">MOTOR1_ESMO</data><data key="type">Parameter</data><data key="description">Enables eSMO based sensorless FOC.</data></node>
<node id="motor1_fast"><data key="label">MOTOR1_FAST</data><data key="type">Parameter</data><data key="description">Enables FAST based sensorless FOC.</data></node>
<node id="motor1_fwc"><data key="label">MOTOR1_FWC</data><data key="type">Parameter</data><data key="description">Enables field weakening control for motor 1; MOTOR1_FWC_N disables it.</data></node>
<node id="motor1_hall"><data key="label">MOTOR1_HALL</data><data key="type">Parameter</data><data key="description">Enables Hall sensors based sensored FOC (with HALL_ENABLE, HALL_CAL).</data></node>
<node id="motor1_isbldc"><data key="label">MOTOR1_ISBLDC</data><data key="type">Parameter</data><data key="description">Enables trapezoidal InstaSPIN-BLDC; supported only on DRV8329AEVM per Table 3-4.</data></node>
<node id="motor1ctrlisr"><data key="label">motor1ctrlISR()</data><data key="type">Software</data><data key="description">Motor control ISR triggered by ADC end of conversion; reads ADC, runs Clarke, estimators, speed/current loops, IPD/FWC/MTPA, I-Park, SVGEN and PWM.</data></node>
<node id="motor_comm_c"><data key="label">motor_comm.c</data><data key="type">Software</data><data key="description">Motor drive common functions file.</data></node>
<node id="motor_common_c"><data key="label">motor_common.c</data><data key="type">Software</data><data key="description">Contains updateCmdSwitch() and updateExtCmdPotFreq().</data></node>
<node id="motor_control_library"><data key="label">Motor control library</data><data key="type">Software</data><data key="description">Common control and motor control specific functions usable as building blocks in a customized motor-control application.</data></node>
<node id="motor_control_parameters_calculation_xlsx"><data key="label">Motor Control Parameters Calculation.xlsx</data><data key="type">Software</data><data key="description">Excel spreadsheet in solutions/universal_motorcontrol_lab/doc for calculating user_mtr1.h parameters.</data></node>
<node id="motor_datalog_fp2_graphprop"><data key="label">motor_datalog_fp2.graphProp</data><data key="type">Software</data><data key="description">Graph configuration file in common\debug importable via Tools -&gt; Graph -&gt; DualTime.</data></node>
<node id="motor_drives"><data key="label">Motor drives</data><data key="type">Application</data><data key="description"></data></node>
<node id="motor_fault_detection"><data key="label">Motor fault detection</data><data key="type">Concept</data><data key="description">Lost phase, phase unbalance, over-load power, stall, failed startup and over-speed faults with time-set filters.</data></node>
<node id="motor_parameter_identification"><data key="label">Motor identification</data><data key="type">Feature</data><data key="description">FAST-based identification of Rs, Ls_d, Ls_q and rated flux; takes about 150 s; can also run online without reloading code.</data></node>
<node id="motor_phase_current"><data key="label">Motor phase current</data><data key="type">Concept</data><data key="description">Measured stator current; only directly measurable physical quantity; two phases fed to Clarke.</data></node>
<node id="motor_phase_voltage"><data key="label">Motor phase voltage feedback</data><data key="type">Concept</data><data key="description">Phase voltages measured directly for FAST for best performance over widest speed range; not required by eSMO.</data></node>
<node id="motor_speed"><data key="label">Motor speed</data><data key="type">Concept</data><data key="description">Motor speed feedback.</data></node>
<node id="motor_start_stop_interface"><data key="label">Start/stop and speed reference interface</data><data key="type">Feature</data><data key="description">Interface functions to start/stop motor and set reference speed via push button, potentiometer, or CAN.</data></node>
<node id="motorcontrol_sdk"><data key="label">C2000Ware MotorControl SDK</data><data key="type">Software</data><data key="description">Software development kit for C2000 real-time controller-based three-phase motor control system development; includes firmware running on C2000 motor control EVMs and TI designs.</data></node>
<node id="motorcontrol_sdk_documentation_html"><data key="label">C2000Ware_MotorControl_SDK_Documentation.html</data><data key="type">Software</data><data key="description">HTML page in the docs directory listing all docs in the MotorControl SDK package.</data></node>
<node id="motorcontrol_sdk_gui"><data key="label">MotorControl SDK GUI</data><data key="type">Software</data><data key="description">Graphical user interface for navigating MotorControl SDK software, libraries, and user's guides; integrated into Code Composer Studio Resource Explorer upon installation.</data></node>
<node id="motorcontrolsdkupdater"><data key="label">MotorControlSDKUpdater.exe</data><data key="type">Software</data><data key="description">Update checking application in the SDK install directory that checks for, downloads and runs a newer MotorControl SDK installer.</data></node>
<node id="motorsetvars_m1_kp_id"><data key="label">motorSetVars_M1.Kp_Id</data><data key="type">Parameter</data><data key="description">Current controller gains (also Ki_Id, Kp_Iq, Ki_Iq) calculated in setupControllers() and tunable.</data></node>
<node id="motorsetvars_m1_kp_spd"><data key="label">motorSetVars_M1.Kp_spd</data><data key="type">Parameter</data><data key="description">Speed controller gains (also Ki_spd) calculated in setupControllers(); a starting reference for tuning.</data></node>
<node id="motorvars_m1_accelerationmax_hzps"><data key="label">motorVars_M1.accelerationMax_Hzps</data><data key="type">Parameter</data><data key="description">Sets the acceleration.</data></node>
<node id="motorvars_m1_adcdata_current_sf"><data key="label">motorVars_M1.adcData.current_sf</data><data key="type">Parameter</data><data key="description">Current scale factor whose sign must match hardware board; related to USER_M1_ADC_FULL_SCALE_CURRENT_A.</data></node>
<node id="motorvars_m1_adcdata_i_a"><data key="label">motorVars_M1.adcData.I_A.value[]</data><data key="type">Parameter</data><data key="description">Phase current samples; default datalog inputs.</data></node>
<node id="motorvars_m1_adcdata_v_v"><data key="label">motorVars_M1.adcData.V_V.value[]</data><data key="type">Parameter</data><data key="description">Phase voltage samples.</data></node>
<node id="motorvars_m1_angleest_rad"><data key="label">motorVars_M1.angleEST_rad</data><data key="type">Parameter</data><data key="description">Estimated rotor angle from FAST or eSMO.</data></node>
<node id="motorvars_m1_anglegen_rad"><data key="label">motorVars_M1.angleGen_rad</data><data key="type">Parameter</data><data key="description">Angle from the force angle generator; monitored vs estimator angle.</data></node>
<node id="motorvars_m1_estimatormode"><data key="label">motorVars_M1.estimatorMode</data><data key="type">Parameter</data><data key="description">Selects estimator in use (ESTIMATOR_MODE_FAST/ESMO/ENC/HALL); can be switched on the fly.</data></node>
<node id="motorvars_m1_faultmtrprev"><data key="label">motorVars_M1.faultMtrPrev.bit</data><data key="type">Parameter</data><data key="description">Fault flag structure checked for no faults.</data></node>
<node id="motorvars_m1_faultmtruse"><data key="label">motorVars_M1.faultMtrUse.all</data><data key="type">Parameter</data><data key="description">Fault flags; should be 0; set to 0x10 on over current fault.</data></node>
<node id="motorvars_m1_flagenablemotoridentify"><data key="label">motorVars_M1.flagEnableMotorIdentify</data><data key="type">Parameter</data><data key="description">Set to 1 to enable online identification without reloading code.</data></node>
<node id="motorvars_m1_flagenablerunandidentify"><data key="label">motorVars_M1.flagEnableRunAndIdentify</data><data key="type">Parameter</data><data key="description">Motor start/stop variable assigned from switch, potentiometer or CAN commands.</data></node>
<node id="motorvars_m1_flagrunidentandonline"><data key="label">motorVars_M1.flagRunIdentAndOnLine</data><data key="type">Parameter</data><data key="description">Set to 1 automatically if there are no faults.</data></node>
<node id="motorvars_m1_idq_set_a"><data key="label">motorVars_M1.Idq_set_A.value[1]</data><data key="type">Parameter</data><data key="description">Reference torque current set in build level 3.</data></node>
<node id="motorvars_m1_overcurrent_a"><data key="label">motorVars_M1.overCurrent_A</data><data key="type">Parameter</data><data key="description">Over current protection threshold; decreasing below phase current triggers fault.</data></node>
<node id="motorvars_m1_speed_hz"><data key="label">motorVars_M1.speed_Hz</data><data key="type">Parameter</data><data key="description">Motor speed; should be close to speedRef_Hz.</data></node>
<node id="motorvars_m1_speedref_hz"><data key="label">motorVars_M1.speedRef_Hz</data><data key="type">Parameter</data><data key="description">Speed reference for the motor; negative value for reverse rotation.</data></node>
<node id="motorvars_m1_svmmode"><data key="label">motorVars_M1.svmMode</data><data key="type">Parameter</data><data key="description">SVM mode selection: SVM_COM_C (common) or SVM_MIN_C (minimum).</data></node>
<node id="motorware"><data key="label">MotorWare</data><data key="type">Software</data><data key="description">Earlier TI motor control software package delivering InstaSPIN-FOC on-chip ROM library for F2806x, F2805x, F2802x.</data></node>
<node id="mtpa"><data key="label">MTPA</data><data key="type">Algorithm</data><data key="description">Maximum torque per ampere: computes current angle beta_mtpa and id/iq references to maximize torque for IPM motors in the constant torque region using reluctance torque; Ld/Lq from a LUT.</data></node>
<node id="mtr1_adc_int_base"><data key="label">MTR1_ADC_INT_BASE</data><data key="type">Parameter</data><data key="description">ADC interrupt source for the control ISR (ADCA INT1 from SOC4), with MTR1_PIE_INT_NUM=INT_ADCA1.</data></node>
<node id="mtr1_adc_trigger_soc"><data key="label">MTR1_ADC_TRIGGER_SOC</data><data key="type">Parameter</data><data key="description">ADC start-of-conversion trigger source; must match the ePWM SOC enabled on pwmHandle[0].</data></node>
<node id="mtr1_cmd_switch_gpio"><data key="label">MTR1_CMD_SWITCH_GPIO</data><data key="type">Parameter</data><data key="description">hal.h define of the command switch GPIO (pull-up, 3-sample qualification).</data></node>
<node id="mtr1_cmpss_dach_value"><data key="label">MTR1_CMPSS_DACH_VALUE</data><data key="type">Parameter</data><data key="description">CMPSS DAC high threshold (max +ve current); MTR1_CMPSS_DACL_VALUE sets max -ve current.</data></node>
<node id="mtr1_cmpss_u_base"><data key="label">MTR1_CMPSS_U_BASE</data><data key="type">Parameter</data><data key="description">CMPSS base for phase U current; V uses CMPSS3_BASE, W shares CMPSS1_BASE.</data></node>
<node id="mtr1_gate_en_gpio"><data key="label">MTR1_GATE_EN_GPIO</data><data key="type">Parameter</data><data key="description">GPIO for enabling the power module (gate driver ENABLE).</data></node>
<node id="mtr1_iu_adc_base"><data key="label">MTR1_IU_ADC_BASE</data><data key="type">Parameter</data><data key="description">ADC module for phase U current (with _ADCRES_BASE, _ADC_CH_NUM, _ADC_SOC_NUM, _ADC_PPB_NUM defines per signal IU/IV/IW/VU/VV/VW/VDC/POT).</data></node>
<node id="mtr1_iu_adc_soc_num"><data key="label">MTR1_IU_ADC_SOC_NUM</data><data key="type">Parameter</data><data key="description">SOC number for phase U current; multiple ADCs may share an SOC number across modules A and C to sample close together.</data></node>
<node id="mtr1_iu_cmphp_sel"><data key="label">MTR1_IU_CMPHP_SEL</data><data key="type">Parameter</data><data key="description">ASYSCTL CMPHPMUX/CMPLPMUX select and _MUX defines that route phase current ADC inputs to CMPSS high/low comparators (IU, IV, IW, IDC).</data></node>
<node id="mtr1_iu_xbar_epwm_mux"><data key="label">MTR1_IU_XBAR_EPWM_MUX</data><data key="type">Parameter</data><data key="description">ePWM X-BAR mux for phase U (CMPSS1 CTRIPH); IV uses CMPSS3 CTRIPH_OR_L, IW uses CMPSS1 CTRIPL.</data></node>
<node id="mtr1_pm_nfault_gpio"><data key="label">MTR1_PM_nFAULT_GPIO</data><data key="type">Parameter</data><data key="description">GPIO for the power module nFAULT input, routed via Input X-BAR to the trip zone.</data></node>
<node id="mtr1_pot_adc_base"><data key="label">MTR1_POT_ADC_BASE</data><data key="type">Parameter</data><data key="description">ADC module for potentiometer (ADCA12, SOC6).</data></node>
<node id="mtr1_pwm_dbred_cnt"><data key="label">MTR1_PWM_DBRED_CNT</data><data key="type">Parameter</data><data key="description">Dead-band rising edge delay count defined in hal.h; with MTR1_PWM_DBFED_CNT for falling edge.</data></node>
<node id="mtr1_pwm_u_base"><data key="label">MTR1_PWM_U_BASE</data><data key="type">Parameter</data><data key="description">hal.h define of phase U PWM base address; also MTR1_PWM_V_BASE (EPWM2_BASE) and MTR1_PWM_W_BASE (EPWM6_BASE).</data></node>
<node id="mtr1_vdc_adc_base"><data key="label">MTR1_VDC_ADC_BASE</data><data key="type">Parameter</data><data key="description">ADC module for DC bus voltage (VSENVM on ADCINC6).</data></node>
<node id="mtr1_xbar_trip"><data key="label">MTR1_XBAR_TRIP</data><data key="type">Parameter</data><data key="description">ePWM X-BAR trip used for overcurrent (TRIP7) with MTR1_DCTRIPIN = EPWM_DC_COMBINATIONAL_TRIPIN7.</data></node>
<node id="new_bldc_driver_support"><data key="label">Supporting new BLDC motor driver board</data><data key="type">Feature</data><data key="description">Procedure (Section 4.2) to implement new or unsupported BLDC motor drivers in the universal lab, using DRV8323RS with SPI as example.</data></node>
<node id="over_modulation"><data key="label">Over-modulation</data><data key="type">Feature</data><data key="description">Driver parameters set for over-modulation voltage; PWM compensation for over modulation run in ISR.</data></node>
<node id="overcurrent_protection"><data key="label">Overcurrent protection</data><data key="type">Concept</data><data key="description">IPM over current protection on TMDSHVMTRINSPIN, enabled by [Main]-J8 with threshold selected by J7/VR1.</data></node>
<node id="overcurrent_trip"><data key="label">Overcurrent trip</data><data key="type">Concept</data><data key="description">Can occur when starting a spinning motor in normal mode; prevented by flying start.</data></node>
<node id="park_run"><data key="label">PARK_run</data><data key="type">Software</data><data key="description">Park transformation.</data></node>
<node id="park_transform"><data key="label">Park transform</data><data key="type">Algorithm</data><data key="description">Most important FOC transform: projects (alpha,beta) into the rotating (d,q) frame aligned with rotor flux, giving DC (time-invariant) flux and torque current components; needs rotor flux position.</data></node>
<node id="pfc_stage"><data key="label">PFC stage</data><data key="type">Component</data><data key="description">Power factor correction stage on TMDSHVMTRINSPIN (750W max); bypassed with BS1-BS5 banana cable.</data></node>
<node id="pga"><data key="label">PGA</data><data key="type">Peripheral</data><data key="description">Programmable Gain Amplifier present on F28004x but not F28002x; needs added functions when porting.</data></node>
<node id="pi_controller"><data key="label">PI controller</data><data key="type">Algorithm</data><data key="description">Proportional-integral regulator used for speed, Id, Iq and field-weakening loops and in the PLL.</data></node>
<node id="pi_gain_scheduling"><data key="label">PI gain scheduling</data><data key="type">Concept</data><data key="description">Kp*/Ki* adjusted by startup/low/high gain coefficients and linear interpolation across condition range.</data></node>
<node id="pi_run"><data key="label">PI_run</data><data key="type">Software</data><data key="description">PI regulators for current and speed.</data></node>
<node id="pie"><data key="label">PIE</data><data key="type">Peripheral</data><data key="description">Peripheral interrupt expansion; ADC and CAN ISRs registered and acknowledged via PIE groups.</data></node>
<node id="pll"><data key="label">PLL</data><data key="type">Algorithm</data><data key="description">Quadrature phase-locked loop position tracker that estimates rotor angular velocity and position from estimated back-EMF, eliminating noise/harmonic effects of the arctangent method.</data></node>
<node id="pll_gains"><data key="label">PLL kp, ki</data><data key="type">Parameter</data><data key="description">Proportional and integral gains of the PLL PI regulator.</data></node>
<node id="pll_position_error"><data key="label">PLL position error</data><data key="type">Concept</data><data key="description">eps = E sin(theta - theta^) simplified to E(theta - theta^) when error &lt; pi/2; normalized eps_n.</data></node>
<node id="pm_flux_linkage"><data key="label">Permanent magnet flux linkage (lambda_pm / psi_m)</data><data key="type">Concept</data><data key="description">Flux linkage generated by the permanent magnets.</data></node>
<node id="pmbus"><data key="label">PMBus</data><data key="type">Peripheral</data><data key="description">Power management bus.</data></node>
<node id="pmsm"><data key="label">PMSM</data><data key="type">Motor</data><data key="description">Permanent magnet synchronous motor: wound stator, permanent magnet rotor, and devices to sense rotor position; low rotor inertia, efficient heat dissipation, reduced size. Not self-starting.</data></node>
<node id="pmsm_dq_model"><data key="label">PMSM d-q dynamic model</data><data key="type">Concept</data><data key="description">[vd;vq] = [Rs+pLd, -we Lq; we Ld, Rs+pLq][id;iq] + [0; we lambda_pm] (Eq 1); alpha-beta model Eq 2; state equation Eq 4.</data></node>
<node id="port_add_new_peripheral_functions"><data key="label">Add functions for new peripherals</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Add functions for peripherals present only on the new MCU (e.g. PGA on F28004x).</data></node>
<node id="port_copy_device_lab"><data key="label">Copy existing device-specific lab folder</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Copy an existing lab folder (e.g. f28002x) and rename it f28004x.</data></node>
<node id="port_edit_projectspec"><data key="label">Edit projectspec file</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Update SysConfig device/package, remove unsupported options (idiv_support), replace 28002x with 28004x, update device and ccxml names.</data></node>
<node id="port_import_project"><data key="label">Import ported project into CCS</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Import universal_motorcontrol_lab_f28004x; missing headers_nonbios cmd only affects watch window debugging.</data></node>
<node id="port_modify_hal"><data key="label">Modify HAL GPIO/PWM/ADC/CMPSS defines</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Modify GPIO, PWM, ADC and CMPSS modules and defines in hal.h as in Section 4.1.2.</data></node>
<node id="port_rebuild_project"><data key="label">Rebuild and fix errors</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Rebuild; fix errors/warnings including driverlib API differences between devices.</data></node>
<node id="port_rename_cmd_files"><data key="label">Rename linker cmd files</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Rename f28002x_flash_lib_is.cmd in the cmd folder for the new device.</data></node>
<node id="port_run_build_levels"><data key="label">Run incremental build levels</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Run the project incrementally using the build levels to verify functionality.</data></node>
<node id="port_to_new_c2000_mcu"><data key="label">Porting reference code to new C2000 MCU</data><data key="type">Feature</data><data key="description">Procedure (Section 4.3) to port the universal lab to other FPU- and TMU-enabled C2000 MCUs, using F28004x as the example target.</data></node>
<node id="port_update_device_files"><data key="label">Replace device.c/device.h</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Copy device.h/device.c from C2000Ware device_support for the new MCU into the lab drivers folders.</data></node>
<node id="port_update_memory_map"><data key="label">Update cmd memory map</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Change memory map in cmd files, optionally adapting generic C2000Ware cmd files.</data></node>
<node id="port_update_source_files"><data key="label">Update lab source files</data><data key="type">Feature</data><data key="description">Porting to new C2000 MCU step: Copy updated cmd, hal.c and hal.h back to the lab folder so changes are done once.</data></node>
<node id="position_sensor"><data key="label">Mechanical position sensor</data><data key="type">Concept</data><data key="description">Rotor position sensor; increases cost, size, reliability problems in home appliances.</data></node>
<node id="potentiometer_speed_control"><data key="label">Potentiometer speed control</data><data key="type">Feature</data><data key="description">Potentiometer on ADCA12 starts/stops motor and sets speed reference, enabled by CMD_POT_EN.</data></node>
<node id="predefined_symbols"><data key="label">Predefined symbols</data><data key="type">Feature</data><data key="description">Project property pre-define symbols that enable/disable functions; a symbol is disabled by appending _N (e.g. MOTOR1_FWC_N).</data></node>
<node id="pull_out"><data key="label">Pull-out</data><data key="type">Concept</data><data key="description">Loss of synchronism when stator field does not rotate at rotor frequency; reason synchronous machine is not self-starting.</data></node>
<node id="pulse_train_logic"><data key="label">Specialized pulse train logic</data><data key="type">Feature</data><data key="description">CLB-implemented pulse train logic.</data></node>
<node id="pwm_output_as_dac_f280x"><data key="label">Using PWM Output as a Digital-to-Analog Converter on a TMS320F280x</data><data key="type">Document</data><data key="description">TI reference document.</data></node>
<node id="pwmdac"><data key="label">PWMDAC</data><data key="type">Software</data><data key="description">Converts software variables into PWM signals on ePWM6A/6B/7A/7B, viewed through external RC low-pass filters.</data></node>
<node id="pwmdacdata_ptrdata"><data key="label">pwmDACData.ptrData[0..3]</data><data key="type">Parameter</data><data key="description">PWMDAC module inputs pointing to four variables, with offset[] and gain[]; set in sys_main.c.</data></node>
<node id="q_axis_current"><data key="label">q-axis current (iq)</data><data key="type">Concept</data><data key="description">Torque component of stator current; linear relation with torque at fixed rotor flux.</data></node>
<node id="q_axis_inductance"><data key="label">q-axis inductance (Lq)</data><data key="type">Concept</data><data key="description">q-axis inductance; varies with iq and saturation.</data></node>
<node id="qep_enable"><data key="label">QEP_ENABLE</data><data key="type">Parameter</data><data key="description">Symbol for QEP encoder based sensored FOC.</data></node>
<node id="rc_low_pass_filter"><data key="label">RC low-pass filter</data><data key="type">Component</data><data key="description">First-order RC filter required to view PWMDAC signals; time constant tau = RC = 1/(2*pi*fc).</data></node>
<node id="release_notes_html"><data key="label">release_notes.html</data><data key="type">Software</data><data key="description">SDK release notes at the MotorControl SDK installation root; contains the Hardware Support table listing device families, EVMs, features and solution locations.</data></node>
<node id="reluctance_torque"><data key="label">Reluctance torque</data><data key="type">Concept</data><data key="description">Torque from difference between d- and q-axis inductance (saliency), proportional to id*iq*(Ld-Lq).</data></node>
<node id="robotics"><data key="label">Robotics</data><data key="type">Application</data><data key="description"></data></node>
<node id="rotor_angle"><data key="label">Rotor angle</data><data key="type">Concept</data><data key="description">Rotor flux angle estimated by FAST/eSMO or measured by encoder/Hall.</data></node>
<node id="rotor_flux_angle"><data key="label">Rotor flux position (theta)</data><data key="type">Concept</data><data key="description">Core of FOC; needed by Park and inverse Park; error misaligns d-axis. In synchronous machines measured by position sensor or speed integration.</data></node>
<node id="rotor_speed"><data key="label">Rotor electrical angular velocity (omega_e)</data><data key="type">Concept</data><data key="description">Electrical angular velocity of the rotor; estimated by PLL/FAST and fed back to speed PI.</data></node>
<node id="rs_online_recalibration"><data key="label">Rs online recalibration</data><data key="type">Feature</data><data key="description">Recalibrates stator resistance in closed loop intermittently, injecting non-torque d-axis current.</data></node>
<node id="runmotor1offsetscalculation"><data key="label">runMotor1OffsetsCalculation()</data><data key="type">Parameter</data><data key="description">Runs ADC offset calibration; defined in motor1_drive.c.</data></node>
<node id="saliency"><data key="label">Saliency ratio</data><data key="type">Concept</data><data key="description">Large saliency ratio of IPMSM yields reluctance torque.</data></node>
<node id="sci"><data key="label">UART</data><data key="type">Peripheral</data><data key="description">Universal asynchronous receiver/transmitter.</data></node>
<node id="sdfm"><data key="label">Sigma Delta Filter Module</data><data key="type">Peripheral</data><data key="description">Sigma-delta filter modules interfacing isolated delta-sigma converters.</data></node>
<node id="sdk_c2000ware_directory"><data key="label">c2000ware (MotorControl SDK directory)</data><data key="type">Software</data><data key="description">Contains the C2000Ware development software and documentation.</data></node>
<node id="sdk_docs_directory"><data key="label">docs (MotorControl SDK directory)</data><data key="type">Software</data><data key="description">Contains the MotorControl SDK package user's guides and a documentation index HTML page.</data></node>
<node id="sdk_libraries_directory"><data key="label">libraries (MotorControl SDK directory)</data><data key="type">Software</data><data key="description">Contains libraries with algorithm modules specific to motor control applications, with documentation and examples when applicable.</data></node>
<node id="sdk_metadata_directory"><data key="label">.metadata (MotorControl SDK directory)</data><data key="type">Software</data><data key="description">Contains the MotorControl SDK Resource Explorer GUI files (do not modify).</data></node>
<node id="sdk_solutions_directory"><data key="label">solutions (MotorControl SDK directory)</data><data key="type">Software</data><data key="description">Contains the development kits and solutions for C2000 devices targeting different application areas; demo code, source code and CCS projects.</data></node>
<node id="sdk_uninstallers_directory"><data key="label">uninstallers (MotorControl SDK directory)</data><data key="type">Software</data><data key="description">Contains the MotorControl SDK uninstaller.</data></node>
<node id="sensored_control"><data key="label">Sensored mode</data><data key="type">Feature</data><data key="description">Sensored motor control using position sensors.</data></node>
<node id="sensored_foc"><data key="label">Sensored FOC</data><data key="type">Feature</data><data key="description">QEP encoder or Hall sensor based sensored-FOC; requires correct wiring order.</data></node>
<node id="sensored_mode"><data key="label">Sensored control</data><data key="type">Feature</data><data key="description">Control using incremental encoder or Hall sensors.</data></node>
<node id="sensorless_control"><data key="label">Sensorless mode</data><data key="type">Feature</data><data key="description">Sensorless motor control.</data></node>
<node id="sensorless_foc"><data key="label">Sensorless FOC</data><data key="type">Algorithm</data><data key="description">FOC of a PMSM without mechanical position sensor using eSMO+PLL or FAST to estimate rotor angle and speed; shown with flying start or with FWC and MTPA.</data></node>
<node id="sensorless_foc_pmsm_single_shunt"><data key="label">Sensorless-FOC for PMSM With Single DC-Link Shunt</data><data key="type">Document</data><data key="description">TI reference document.</data></node>
<node id="sensorless_mode"><data key="label">Sensorless control</data><data key="type">Feature</data><data key="description">Rotor speed/position estimation without mechanical sensor (FAST, eSMO, InstaSPIN-BLDC).</data></node>
<node id="sensorless_trapezoidal_control"><data key="label">Sensorless trapezoidal control</data><data key="type">Algorithm</data><data key="description">Sensorless trapezoidal control listed for DRV8329AEVM.</data></node>
<node id="servo_drives"><data key="label">Servo drives</data><data key="type">Application</data><data key="description">Precision drives targeted by BOOSTXL-3PHGANINV.</data></node>
<node id="setupcontrollers"><data key="label">setupControllers()</data><data key="type">Software</data><data key="description">Function calculating default Kp and Ki for current and speed controllers.</data></node>
<node id="sfra"><data key="label">SFRA</data><data key="type">Software</data><data key="description">Software frequency response analyzer tool; SFRA specific files are in the project.</data></node>
<node id="sfra_enable"><data key="label">SFRA_ENABLE</data><data key="type">Parameter</data><data key="description">Enables SFRA tool.</data></node>
<node id="sfra_library_ug"><data key="label">C2000 Software Frequency Response Analyzer (SFRA) Library User's Guide</data><data key="type">Document</data><data key="description">TI reference document.</data></node>
<node id="shoot_through_protection"><data key="label">Shoot-through protection</data><data key="type">Concept</data><data key="description">Drive-stage shoot-through protection.</data></node>
<node id="short_circuit_protection"><data key="label">Short circuit protection</data><data key="type">Concept</data><data key="description">Drive stage protection against short circuit (with thermal, shoot-through and undervoltage).</data></node>
<node id="single_shunt_current_sensing"><data key="label">Single shunt dc-link current sensing</data><data key="type">Concept</data><data key="description">DC-link single shunt sensing with USER_M1_IDC_OFFSET_AD and DCLINKSS timing parameters.</data></node>
<node id="sliding_mode_gain"><data key="label">Sliding mode gains k_alpha, k_beta</data><data key="type">Parameter</data><data key="description">Constant sliding mode gains designed by Lyapunov stability analysis.</data></node>
<node id="sliding_surface"><data key="label">Sliding surface</data><data key="type">Concept</data><data key="description">Selected on the stator current path: S = i^ - i (Eq 5), since stator current is the only directly measurable quantity.</data></node>
<node id="solar"><data key="label">Solar</data><data key="type">Application</data><data key="description"></data></node>
<node id="spdcalc_run"><data key="label">SPDCALC_run</data><data key="type">Software</data><data key="description">Speed measurement based on encoder angle.</data></node>
<node id="spdfr_run"><data key="label">SPDFR_run</data><data key="type">Software</data><data key="description">Speed measurement based on observer angle (eSMO).</data></node>
<node id="speed_est"><data key="label">Speed_est</data><data key="type">Parameter</data><data key="description">Estimated speed read during flying start.</data></node>
<node id="speed_fs_min"><data key="label">Speed_fs_min</data><data key="type">Parameter</data><data key="description">Minimum speed threshold in the flying start flowchart; if Speed_est is below it, Speed_int is set to 0, else Speed_int=Speed_est.</data></node>
<node id="speed_pi_controller"><data key="label">Speed PI controller</data><data key="type">Algorithm</data><data key="description">Speed regulator whose output is the torque command Iq_ref (or Is_ref with FW/MTPA); disabled during flying start.</data></node>
<node id="speed_pulse_control"><data key="label">Speed pulse control</data><data key="type">Feature</data><data key="description">Motor speed calculated from a pulse on an input GPIO; speed above max disables motor.</data></node>
<node id="speed_trajectory"><data key="label">Speed trajectory ramp</data><data key="type">Algorithm</data><data key="description">Traj Ramp that ramps the speed reference SpdRef to wref for the speed controller.</data></node>
<node id="spi"><data key="label">SPI</data><data key="type">Peripheral</data><data key="description">Serial interface from the MCU to the BLDC motor driver (SPIA, 16-bit words, POL0PHA0, master).</data></node>
<node id="spmsm"><data key="label">SPM</data><data key="type">Motor</data><data key="description">Surface-mounted PMSM; easier to control due to linear torque vs q-axis current relation; conventional control sets id to zero.</data></node>
<node id="sprt755"><data key="label">SPRT755</data><data key="type">Document</data><data key="description">Product overview of C2000 F280013x real-time microcontrollers (October 2022).</data></node>
<node id="spruio7a"><data key="label">SPRUIO7A</data><data key="type">Document</data><data key="description">C2000Ware MotorControl SDK Getting Started Guide, Rev. A (March 2019, revised October 2022).</data></node>
<node id="spruj26a"><data key="label">SPRUJ26A</data><data key="type">Document</data><data key="description">Motor Control SDK Universal Project and Lab User's Guide, Rev. A (September 2021, revised April 2024); covers building a custom board, supporting new BLDC motor drivers, porting to new C2000 MCUs, and motor control parameters.</data></node>
<node id="src_board"><data key="label">src_board</data><data key="type">Software</data><data key="description">Folder with board-, motor- and device-specific files (hal.c, hal.h, user_mtr1.h).</data></node>
<node id="src_control"><data key="label">src_control</data><data key="type">Software</data><data key="description">Folder with motor drive control files calling core algorithm functions within ISRs and background tasks.</data></node>
<node id="src_foc"><data key="label">src_foc</data><data key="type">Software</data><data key="description">Folder with FOC modules (Park, Clarke, inverse transforms, PID, estimators) independent of device/board.</data></node>
<node id="src_lib"><data key="label">src_lib</data><data key="type">Software</data><data key="description">Folder with the InstaSPIN-FOC library and math library.</data></node>
<node id="src_sys"><data key="label">src_sys</data><data key="type">Software</data><data key="description">Folder reserved for user system control, communication, etc.</data></node>
<node id="sszt350"><data key="label">SSZT350</data><data key="type">Document</data><data key="description">Technical article 'Customizing On-chip Peripherals Defies Conventional Logic' about the C2000 configurable logic block (January 2020).</data></node>
<node id="sszt464"><data key="label">SSZT464</data><data key="type">Document</data><data key="description">Technical article 'Real-time Controllers Get New Connectivity Capabilities' introducing the F2838x series (June 2019).</data></node>
<node id="sszt496"><data key="label">SSZT496</data><data key="type">Document</data><data key="description">Technical article 'Motor Control Software Development Kit Jump-starts New Designs' introducing the C2000Ware MotorControl SDK (September 2019).</data></node>
<node id="stator_current_angle"><data key="label">Stator current angle (beta)</data><data key="type">Concept</data><data key="description">Angle of stator current in d-q frame: Id = Is cos(beta), Iq = Is sin(beta) (Eq 33-35).</data></node>
<node id="stator_current_space_vector"><data key="label">Stator current space vector</data><data key="type">Concept</data><data key="description">Complex vector i_s = ia + a*ib + a^2*ic with a = e^(j2pi/3) (Eq 8).</data></node>
<node id="stator_resistance"><data key="label">Stator resistance (Rs)</data><data key="type">Concept</data><data key="description">Resistance of stator windings; negligible at high speed.</data></node>
<node id="step_response"><data key="label">Step response with graph tool</data><data key="type">Feature</data><data key="description">Step response function shown with the graph tool.</data></node>
<node id="step_rp_en"><data key="label">STEP_RP_EN</data><data key="type">Parameter</data><data key="description">Enables step response with graph tool.</data></node>
<node id="svgen_run"><data key="label">SVGEN_run</data><data key="type">Software</data><data key="description">Space vector PWM with quadrature control.</data></node>
<node id="svpwm"><data key="label">SVPWM</data><data key="type">Algorithm</data><data key="description">Space Vector PWM takes Vsalpharef/Vsbetaref and produces signals (Ta, Tb, Tc) that drive the inverter; limits max voltage to vdc/sqrt3.</data></node>
<node id="sys_main_c"><data key="label">sys_main.c</data><data key="type">Software</data><data key="description">System main file; initializes DATALOG, PWMDAC and DAC128S objects and their input pointers; holds userParams_M1.flag_bypassMotorId.</data></node>
<node id="sys_settings_h"><data key="label">sys_settings.h</data><data key="type">Software</data><data key="description">Build level setting file; DMC_BUILDLEVEL is set here.</data></node>
<node id="sysconfig"><data key="label">SysConfig</data><data key="type">Software</data><data key="description">C2000 MCU SysConfig graphical device configuration: peripheral configuration, application calculators, PinMux, DCSM security, dependency detection, library setup, memory configuration, board components, ePWM support, FreeRTOS configuration.</data></node>
<node id="systemvars_esttype"><data key="label">systemVars.estType</data><data key="type">Parameter</data><data key="description">Indicates enabled estimator combination: EST_TYPE_FAST_ESMO, EST_TYPE_FAST_ENC, EST_TYPE_FAST_HALL, EST_TYPE_ESMO_ENC.</data></node>
<node id="systemvars_flagenablesystem"><data key="label">systemVars.flagEnableSystem</data><data key="type">Parameter</data><data key="description">Set to 1 automatically after offset calibration completes.</data></node>
<node id="temperature_sensor"><data key="label">Temperature Sensor</data><data key="type">Peripheral</data><data key="description">On-chip temperature sensor.</data></node>
<node id="test_enable"><data key="label">TEST_ENABLE</data><data key="type">Parameter</data><data key="description">Predefine required for ISRCount to increment.</data></node>
<node id="thermal_protection"><data key="label">Thermal protection</data><data key="type">Concept</data><data key="description">Drive-stage thermal protection.</data></node>
<node id="three_phase_inverter"><data key="label">Three-phase inverter</data><data key="type">Component</data><data key="description">Standard three-phase (two-level voltage source) inverter driven by PWM signals to control the motor; its max phase voltage is limited by DC-link voltage and PWM strategy.</data></node>
<node id="three_phase_motor_control"><data key="label">Three-phase motor control</data><data key="type">Application</data><data key="description">Three-phase motor control applications.</data></node>
<node id="three_shunt_current_sensing"><data key="label">Three low-side current shunt sensing</data><data key="type">Concept</data><data key="description">Three phase-current sensing with per-phase CMPSS mux defines.</data></node>
<node id="ti_linker_command_file_primer"><data key="label">TI Linker Command File Primer</data><data key="type">Document</data><data key="description">In-depth introduction and basic usage guide for linker cmd files.</data></node>
<node id="tmdsadap180to100"><data key="label">TMDSADAP180TO100</data><data key="type">EvaluationKit</data><data key="description">Adapter allowing 180-pin C2000 controlCARDs to be used with existing 100-pin DIMM based evaluation tools.</data></node>
<node id="tmdscncd2800137"><data key="label">TMS320F2800137 controlCARD</data><data key="type">EvaluationKit</data><data key="description">Low-cost evaluation board (controlCARD) for F280013X devices with HSEC180 connector; used on TMDSHVMTRINSPIN via TMDSADAP180TO100.</data></node>
<node id="tmdscncd280025c"><data key="label">TMDSCNCD280025C</data><data key="type">EvaluationKit</data><data key="description">Low-cost evaluation board (controlCARD) for F28002X devices with HSEC180 connector; used on TMDSHVMTRINSPIN via TMDSADAP180TO100.</data></node>
<node id="tmdscncd280039c"><data key="label">TMDSCNCD280039C</data><data key="type">EvaluationKit</data><data key="description">Low-cost evaluation board (controlCARD) for F28003X devices with HSEC180 connector; used on TMDSHVMTRINSPIN via TMDSADAP180TO100.</data></node>
<node id="tmdscncd28388d"><data key="label">TMDSCNCD28388D</data><data key="type">EvaluationKit</data><data key="description">Tool folder for F28388D development tools (controlCARD).</data></node>
<node id="tmdshvmtrinspin"><data key="label">TMDSHVMTRINSPIN</data><data key="type">EvaluationKit</data><data key="description">DIMM100 controlCARD based high voltage motor control kit for ACI, BLDC and PMSM motors with DC bus and three-phase voltage sensing and three low-side current shunts.</data></node>
<node id="tmu"><data key="label">TMU</data><data key="type">Peripheral</data><data key="description">Trigonometric Math Unit; speeds up algorithms key to real-time control (arctan, sin, cos).</data></node>
<node id="traj_run"><data key="label">TRAJ_run</data><data key="type">Software</data><data key="description">Trajectory for setting speed reference.</data></node>
<node id="trapezoidal_control"><data key="label">Trapezoidal control</data><data key="type">Algorithm</data><data key="description">Motor control technique offered in the lab alongside FOC.</data></node>
<node id="trip_zone"><data key="label">Trip Zone</data><data key="type">Peripheral</data><data key="description">PWM fault trip zones.</data></node>
<node id="undervoltage_protection"><data key="label">Undervoltage protection</data><data key="type">Concept</data><data key="description">Drive-stage undervoltage protection.</data></node>
<node id="universal_gui"><data key="label">C2000 InstaSPIN Universal GUI</data><data key="type">Software</data><data key="description">Online GUI in the TI Cloud Tools Gallery providing a dashboard for viewing and updating variables in the F28004x InstaSPIN-FOC lab projects; can be customized in GUI Composer.</data></node>
<node id="universal_lab_level_txt"><data key="label">universal_lab_levelN.txt</data><data key="type">Software</data><data key="description">Expression variable lists (universal_lab_level1..4.txt) in common\debug imported into the Expressions window per build level.</data></node>
<node id="universal_motor_control_lab"><data key="label">Universal Motor Control Lab</data><data key="type">Software</data><data key="description">Single project with build examples for sensorless (FAST, eSMO, InstaSPIN-BLDC) and sensored (incremental encoder, Hall) motor control techniques (FOC, trapezoidal), with system features and debug interfaces usable across three-phase inverter motor EVMs.</data></node>
<node id="universal_motorcontrol_lab_projectspec"><data key="label">universal_motorcontrol_lab.projectspec</data><data key="type">Software</data><data key="description">CCS projectspec that generates the project and references device-specific C2000Ware files.</data></node>
<node id="universal_motorcontrol_syscfg"><data key="label">universal_motorcontrol_syscfg</data><data key="type">Software</data><data key="description">SysConfig-enabled version of the universal motor control lab; replaces universal_motorcontrol_lab in porting instructions.</data></node>
<node id="updatecancmdfreq"><data key="label">updateCANCmdFreq()</data><data key="type">Parameter</data><data key="description">Processes CAN received/transmitted data and links it to motor control variables; called in endless loop.</data></node>
<node id="updatecmdswitch"><data key="label">updateCmdSwitch()</data><data key="type">Parameter</data><data key="description">motor_common.c function reading the switch GPIO with a digital filter and linking state to start/stop.</data></node>
<node id="updateextcmdpotfreq"><data key="label">updateExtCmdPotFreq()</data><data key="type">Parameter</data><data key="description">motor_common.c function converting the potentiometer ADC value to a speed value.</data></node>
<node id="usb"><data key="label">USB</data><data key="type">Peripheral</data><data key="description">Universal serial bus.</data></node>
<node id="user_adc_full_scale_voltage_v"><data key="label">USER_ADC_FULL_SCALE_VOLTAGE_V</data><data key="type">Parameter</data><data key="description">Software value used by eSMO to represent phase voltages; depends on the voltage feedback circuit.</data></node>
<node id="user_common_h"><data key="label">user_common.h</data><data key="type">Software</data><data key="description">Common user definitions file used with user_mtr1.h to select or define the motor model.</data></node>
<node id="user_idref"><data key="label">User_IdRef</data><data key="type">Parameter</data><data key="description">User d-axis current reference fed to Id_ref.</data></node>
<node id="user_m1_adc_full_scale_current_a"><data key="label">USER_M1_ADC_FULL_SCALE_CURRENT_A</data><data key="type">Parameter</data><data key="description">ADC full-scale current; used in DAC gains and current scale factors.</data></node>
<node id="user_m1_adc_full_scale_voltage_v"><data key="label">USER_M1_ADC_FULL_SCALE_VOLTAGE_V</data><data key="type">Parameter</data><data key="description">Maximum voltage at the ADC input; scales ADC voltage readings.</data></node>
<node id="user_m1_current_sf"><data key="label">USER_M1_CURRENT_SF</data><data key="type">Parameter</data><data key="description">Derived scale of ADC bits to Amps assuming 12-bit ADC.</data></node>
<node id="user_m1_dclinkss_min_duration"><data key="label">USER_M1_DCLINKSS_MIN_DURATION</data><data key="type">Parameter</data><data key="description">Minimum duration in clock cycles for single-shunt ADC readings.</data></node>
<node id="user_m1_est_bemf_hf_sf"><data key="label">USER_M1_EST_BEMF_HF_SF</data><data key="type">Parameter</data><data key="description">Back-EMF estimation scale factor (default 1 for FAST; 0.5-1.25 otherwise).</data></node>
<node id="user_m1_fail_speed_max_hz"><data key="label">USER_M1_FAIL_SPEED_MAX_HZ</data><data key="type">Parameter</data><data key="description">Over-speed fault threshold (200%-500% rated).</data></node>
<node id="user_m1_force_angle_freq_hz"><data key="label">USER_M1_FORCE_ANGLE_FREQ_Hz</data><data key="type">Parameter</data><data key="description">Force angle startup frequency, typically +-1 Hz.</data></node>
<node id="user_m1_fwc_kp"><data key="label">USER_M1_FWC_KP</data><data key="type">Parameter</data><data key="description">Kp gain of FWC PI regulator (0.01-0.1); with USER_M1_FWC_KI.</data></node>
<node id="user_m1_fwc_max_angle"><data key="label">USER_M1_FWC_MAX_ANGLE</data><data key="type">Parameter</data><data key="description">Maximum FWC vector angle, 0 to -45 degrees.</data></node>
<node id="user_m1_idc_offset_ad"><data key="label">USER_M1_IDC_OFFSET_AD</data><data key="type">Parameter</data><data key="description">ADC current offset for single-shunt hardware.</data></node>
<node id="user_m1_is_offset_ad_delta"><data key="label">USER_M1_IS_OFFSET_AD_DELTA</data><data key="type">Parameter</data><data key="description">Error threshold (0-200) for phase current ADC offsets; beyond triggers fault.</data></node>
<node id="user_m1_ix_offset_ad"><data key="label">USER_M1_Ix_OFFSET_AD</data><data key="type">Parameter</data><data key="description">ADC current offset per phase (A/B/C), close to 2048; updated by offset calibration.</data></node>
<node id="user_m1_lost_phase_current_a"><data key="label">USER_M1_LOST_PHASE_CURRENT_A</data><data key="type">Parameter</data><data key="description">Lost phase fault current threshold (0.1%-10% of rated).</data></node>
<node id="user_m1_max_vs_mag_pu"><data key="label">USER_M1_MAX_VS_MAG_PU</data><data key="type">Parameter</data><data key="description">Maximum voltage vector magnitude Vs in per-unit.</data></node>
<node id="user_m1_nominal_dc_bus_voltage_v"><data key="label">USER_M1_NOMINAL_DC_BUS_VOLTAGE_V</data><data key="type">Parameter</data><data key="description">Nominal DC bus voltage; must exceed rated motor voltage and be below max sensing DC bus voltage.</data></node>
<node id="user_m1_num_current_sensors"><data key="label">USER_M1_NUM_CURRENT_SENSORS</data><data key="type">Parameter</data><data key="description">Number of current sensors (2 or 3, else compile error).</data></node>
<node id="user_m1_num_isr_ticks_per_speed_tick"><data key="label">USER_M1_NUM_ISR_TICKS_PER_SPEED_TICK</data><data key="type">Parameter</data><data key="description">Interrupt ticks per speed controller tick.</data></node>
<node id="user_m1_num_pwm_ticks_per_isr_tick"><data key="label">USER_M1_NUM_PWM_TICKS_PER_ISR_TICK</data><data key="type">Parameter</data><data key="description">PWM periods per interrupt (1 to 3); divides control interrupt frequency.</data></node>
<node id="user_m1_num_voltage_sensors"><data key="label">USER_M1_NUM_VOLTAGE_SENSORS</data><data key="type">Parameter</data><data key="description">Number of phase voltage sensors (must be 3).</data></node>
<node id="user_m1_over_current_times_set"><data key="label">USER_M1_OVER_CURRENT_TIMES_SET</data><data key="type">Parameter</data><data key="description">Duration (5ms periods) to set over-current fault (0.01-0.5s).</data></node>
<node id="user_m1_over_load_power_w"><data key="label">USER_M1_OVER_LOAD_POWER_W</data><data key="type">Parameter</data><data key="description">Over-power fault threshold (50%-200% rated power).</data></node>
<node id="user_m1_over_voltage_fault_v"><data key="label">USER_M1_OVER_VOLTAGE_FAULT_V</data><data key="type">Parameter</data><data key="description">DC bus over-voltage fault threshold; less than ADC full-scale voltage.</data></node>
<node id="user_m1_pot_adc_min"><data key="label">USER_M1_POT_ADC_MIN</data><data key="type">Parameter</data><data key="description">Minimum potentiometer ADC value; below it speed is 0.</data></node>
<node id="user_m1_pot_speed_sf"><data key="label">USER_M1_POT_SPEED_SF</data><data key="type">Parameter</data><data key="description">Derived ADC-to-speed relationship for potentiometer control.</data></node>
<node id="user_m1_pwm_freq_khz"><data key="label">USER_M1_PWM_FREQ_kHz</data><data key="type">Parameter</data><data key="description">ePWM frequency in kHz; changing it alters the control interrupt frequency.</data></node>
<node id="user_m1_pwm_tbprd_num"><data key="label">USER_M1_PWM_TBPRD_NUM</data><data key="type">Parameter</data><data key="description">PWM period value setting the PWM frequency in HAL_setupPWMs().</data></node>
<node id="user_m1_sign_current_sf"><data key="label">USER_M1_SIGN_CURRENT_SF</data><data key="type">Parameter</data><data key="description">Sign of current scale factor: -1.0f if op-amp noninverting pin grounded, +1.0f if inverting pin grounded.</data></node>
<node id="user_m1_speed_cap_max_hz"><data key="label">USER_M1_SPEED_CAP_MAX_Hz</data><data key="type">Parameter</data><data key="description">Max speed in pulse control; above it the motor is disabled.</data></node>
<node id="user_m1_stall_current_a"><data key="label">USER_M1_STALL_CURRENT_A</data><data key="type">Parameter</data><data key="description">Stall/failed-startup RMS current threshold below USER_M1_FAIL_SPEED_MIN_HZ.</data></node>
<node id="user_m1_switch_wait_time_set"><data key="label">USER_M1_SWITCH_WAIT_TIME_SET</data><data key="type">Parameter</data><data key="description">Minimum wait between switch state updates in 1ms periods (default 50ms).</data></node>
<node id="user_m1_unbalance_ratio"><data key="label">USER_M1_UNBALANCE_RATIO</data><data key="type">Parameter</data><data key="description">Phase unbalance ratio threshold (default 20%).</data></node>
<node id="user_m1_under_voltage_fault_v"><data key="label">USER_M1_UNDER_VOLTAGE_FAULT_V</data><data key="type">Parameter</data><data key="description">DC bus under-voltage fault threshold.</data></node>
<node id="user_m1_voltage_filter_pole_hz"><data key="label">USER_M1_VOLTAGE_FILTER_POLE_Hz</data><data key="type">Parameter</data><data key="description">Analog voltage feedback filter pole location; must match hardware filter.</data></node>
<node id="user_m1_voltage_sf"><data key="label">USER_M1_VOLTAGE_SF</data><data key="type">Parameter</data><data key="description">Derived ADC voltage scale; used only by FAST and eSMO estimators.</data></node>
<node id="user_m1_vx_offset_sf"><data key="label">USER_M1_Vx_OFFSET_SF</data><data key="type">Parameter</data><data key="description">ADC voltage offset per phase, close to 0.5; used only for InstaSPIN-FOC FAST and InstaSPIN-BLDC.</data></node>
<node id="user_motor1_bemf_threshold"><data key="label">USER_MOTOR1_BEMF_THRESHOLD</data><data key="type">Parameter</data><data key="description">Estimated current error threshold for eSMO sliding mode controller (0.3-0.5, default 0.5).</data></node>
<node id="user_motor1_brake_current_a"><data key="label">USER_MOTOR1_BRAKE_CURRENT_A</data><data key="type">Parameter</data><data key="description">Motor current during braking (10%-50% of rated).</data></node>
<node id="user_motor1_flux_exc_freq_hz"><data key="label">USER_MOTOR1_FLUX_EXC_FREQ_Hz</data><data key="type">Parameter</data><data key="description">Flux excitation frequency for identification, 10~30% of rated frequency.</data></node>
<node id="user_motor1_freq_high_hz"><data key="label">USER_MOTOR1_FREQ_HIGH_HZ</data><data key="type">Parameter</data><data key="description">v/f profile high frequency.</data></node>
<node id="user_motor1_freq_low_hz"><data key="label">USER_MOTOR1_FREQ_LOW_HZ</data><data key="type">Parameter</data><data key="description">Low frequency boundary of open-loop V/F profile (~10% rated frequency).</data></node>
<node id="user_motor1_freq_max_hz"><data key="label">USER_MOTOR1_FREQ_MAX_Hz</data><data key="type">Parameter</data><data key="description">Maximum rotational speed in Hz (100%-150% of rated).</data></node>
<node id="user_motor1_gain_iq_low_a"><data key="label">USER_MOTOR1_GAIN_IQ_LOW_A</data><data key="type">Parameter</data><data key="description">Low current threshold for q-axis current PI gain adjustment (10%-50% rated).</data></node>
<node id="user_motor1_gain_speed_low_hz"><data key="label">USER_MOTOR1_GAIN_SPEED_LOW_Hz</data><data key="type">Parameter</data><data key="description">Low speed threshold for speed PI Kp*/Ki* adjustment (10%-30% rated).</data></node>
<node id="user_motor1_ind_est_current_a"><data key="label">USER_MOTOR1_IND_EST_CURRENT_A</data><data key="type">Parameter</data><data key="description">Identification current for inductance estimation, 10~30% of rated current, enough to rotate.</data></node>
<node id="user_motor1_inertia_kgm2"><data key="label">USER_MOTOR1_INERTIA_Kgm2</data><data key="type">Parameter</data><data key="description">Moment of inertia; contributes to speed controller gain calculation.</data></node>
<node id="user_motor1_isbldc_int_max"><data key="label">USER_MOTOR1_ISBLDC_INT_MAX</data><data key="type">Parameter</data><data key="description">Maximum integration voltage threshold for commutation point detection (0.01-0.15).</data></node>
<node id="user_motor1_kslide_max"><data key="label">USER_MOTOR1_KSLIDE_MAX</data><data key="type">Parameter</data><data key="description">Maximum eSMO Kslide gain (0.1-10).</data></node>
<node id="user_motor1_ls_d_comp_coef"><data key="label">USER_MOTOR1_Ls_d_COMP_COEF</data><data key="type">Parameter</data><data key="description">Ls d-axis compensation coefficient: Ls1 = Ls*(1 - coef).</data></node>
<node id="user_motor1_ls_d_h"><data key="label">USER_MOTOR1_Ls_d_H</data><data key="type">Parameter</data><data key="description">d-axis inductance; replaced with identified motorSetVars_M1.Ls_d_H.</data></node>
<node id="user_motor1_ls_q_h"><data key="label">USER_MOTOR1_Ls_q_H</data><data key="type">Parameter</data><data key="description">q-axis inductance; replaced with identified motorSetVars_M1.Ls_q_H.</data></node>
<node id="user_motor1_max_current_a"><data key="label">USER_MOTOR1_MAX_CURRENT_A</data><data key="type">Parameter</data><data key="description">Maximum motor current; contributes to overcurrent handling.</data></node>
<node id="user_motor1_num_enc_slots"><data key="label">USER_MOTOR1_NUM_ENC_SLOTS</data><data key="type">Parameter</data><data key="description">Number of encoder slots per rotation (not quadrature counts); wrong value makes motor spin faster or slower.</data></node>
<node id="user_motor1_num_pole_pairs"><data key="label">USER_MOTOR1_NUM_POLE_PAIRS</data><data key="type">Parameter</data><data key="description">Number of motor pole pairs.</data></node>
<node id="user_motor1_over_current_a"><data key="label">USER_MOTOR1_OVER_CURRENT_A</data><data key="type">Parameter</data><data key="description">Over-current threshold used to calculate CMPSS DAC values which trigger PWM trip-zone fault handling (50%-300% rated).</data></node>
<node id="user_motor1_pll_kp_max"><data key="label">USER_MOTOR1_PLL_KP_MAX</data><data key="type">Parameter</data><data key="description">Maximum eSMO PLL gain (0.1-10).</data></node>
<node id="user_motor1_ramp_end_hz"><data key="label">USER_MOTOR1_RAMP_END_Hz</data><data key="type">Parameter</data><data key="description">Speed at which BEMF zero-cross commutation begins to be considered (10%-20% rated).</data></node>
<node id="user_motor1_rated_flux_vphz"><data key="label">USER_MOTOR1_RATED_FLUX_VpHz</data><data key="type">Parameter</data><data key="description">Rated flux; replaced with identified motorSetVars_M1.flux_VpHz.</data></node>
<node id="user_motor1_rated_voltage_v"><data key="label">USER_MOTOR1_RATED_VOLTAGE_V</data><data key="type">Parameter</data><data key="description">Rated motor voltage; could be NOMINAL_DC_BUS_VOLTAGE/sqrt(2).</data></node>
<node id="user_motor1_res_est_current_a"><data key="label">USER_MOTOR1_RES_EST_CURRENT_A</data><data key="type">Parameter</data><data key="description">Identification current for resistance estimation, 10~30% of rated current.</data></node>
<node id="user_motor1_rr_ohm"><data key="label">USER_MOTOR1_Rr_Ohm</data><data key="type">Parameter</data><data key="description">Rotor resistance.</data></node>
<node id="user_motor1_rs_ohm"><data key="label">USER_MOTOR1_Rs_Ohm</data><data key="type">Parameter</data><data key="description">Stator resistance; replaced with identified motorSetVars_M1.Rs_Ohm.</data></node>
<node id="user_motor1_rsonline_wait_time"><data key="label">USER_MOTOR1_RSONLINE_WAIT_TIME</data><data key="type">Parameter</data><data key="description">Wait time between Rs online calibration cycles in 5ms periods.</data></node>
<node id="user_motor1_speed_fs_hz"><data key="label">USER_MOTOR1_SPEED_FS_Hz</data><data key="type">Parameter</data><data key="description">Flying-start speed threshold (0.1%-5% of rated).</data></node>
<node id="user_motor1_type"><data key="label">USER_MOTOR1_TYPE</data><data key="type">Parameter</data><data key="description">Motor type: MOTOR_TYPE_PM (BLDC, PMSM, SMPM, IPM) or MOTOR_TYPE_INDUCTION.</data></node>
<node id="user_motor1_volt_max_v"><data key="label">USER_MOTOR1_VOLT_MAX_V</data><data key="type">Parameter</data><data key="description">Voltage generating USER_MOTOR1_FREQ_HIGH_Hz; set to rated voltage.</data></node>
<node id="user_motor1_volt_min_v"><data key="label">USER_MOTOR1_VOLT_MIN_V</data><data key="type">Parameter</data><data key="description">v/f profile minimum voltage.</data></node>
<node id="user_mtr1_c"><data key="label">user_mtr1.c</data><data key="type">Software</data><data key="description">Board and motor specific parameters source file.</data></node>
<node id="user_mtr1_h"><data key="label">user_mtr1.h</data><data key="type">Software</data><data key="description">Header file that stores all user parameters; parameters must be updated here to be saved permanently in the project.</data></node>
<node id="userparams_m1_current_sf"><data key="label">userParams_M1.current_sf</data><data key="type">Parameter</data><data key="description">User current scale factor related to USER_M1_ADC_FULL_SCALE_CURRENT_A.</data></node>
<node id="userparams_m1_flag_bypassmotorid"><data key="label">userParams_M1.flag_bypassMotorId</data><data key="type">Parameter</data><data key="description">In sys_main.c; false enables motor identification, true disables it.</data></node>
<node id="vf_control"><data key="label">V/f control</data><data key="type">Algorithm</data><data key="description">Scalar open-loop voltage/frequency control used in build level 2.</data></node>
<node id="vf_profile"><data key="label">Open-loop V/F profile</data><data key="type">Concept</data><data key="description">Linear voltage/frequency region defined by FREQ_LOW/HIGH and VOLT_MIN/MAX.</data></node>
<node id="voltage_feedback_circuit"><data key="label">Voltage feedback circuit (resistor divider)</data><data key="type">Component</data><data key="description">Resistor-divider circuit that filters and scales motor phase and DC bus voltages for the ADC input range.</data></node>
<node id="voltage_filter_pole"><data key="label">Voltage filter pole</data><data key="type">Parameter</data><data key="description">Hardware-dependent parameter for voltage feedback filtering for FAST or eSMO.</data></node>
<node id="voltage_limit"><data key="label">Voltage limit ellipse</data><data key="type">Concept</data><data key="description">sqrt(vd^2+vq^2) &lt;= Vmax (Eq 30); ellipse shrinking with speed (Eq 32).</data></node>
<node id="voltage_reconstruction"><data key="label">Voltage reconstruction</data><data key="type">Algorithm</data><data key="description">Volt_Rec block reconstructing alpha-beta phase voltages from Vbus and PWM for eSMO.</data></node>
<node id="voltage_scale_value"><data key="label">Voltage scale value</data><data key="type">Parameter</data><data key="description">Hardware-dependent parameter that must be set correctly to identify and run the motor with FOC.</data></node>
<node id="voltage_sensing"><data key="label">DC bus and three-phase voltage sensing</data><data key="type">Concept</data><data key="description">Individual DC bus and three-phase voltage sensing on the inverter module.</data></node>
<node id="vs_freq_run"><data key="label">VS_FREQ_run</data><data key="type">Software</data><data key="description">Generates vector voltage with v/f profile.</data></node>
<node id="wait_boot_mode"><data key="label">Wait boot mode</data><data key="type">Feature</data><data key="description">Boot mode set by GPIO24=0 and GPIO32=1, reducing risk of connectivity issues or execution of previously loaded code.</data></node>
<node id="watchdog"><data key="label">Watchdog Timer</data><data key="type">Peripheral</data><data key="description">NMI watchdog timer.</data></node>
<node id="xbar"><data key="label">X-BAR</data><data key="type">Peripheral</data><data key="description">ePWM X-BAR and Input X-BAR route CMPSS trip outputs and the nFAULT GPIO to the ePWM trip zone.</data></node>
<node id="xds100v2"><data key="label">XDS100v2 emulator</data><data key="type">Component</data><data key="description">On-card emulator on TMDSCNCD280025C; XDS100 also on TMDSHVMTRINSPIN.</data></node>
<node id="xds110"><data key="label">XDS110 debugger</data><data key="type">Component</data><data key="description">On-board debugger with virtual COM port on LaunchPads and controlCARDs.</data></node>
<edge id="e0" source="acim" target="current_model"><data key="rel">uses</data><data key="evidence">Basic method is use of the current model to calculate theta.</data></edge>
<edge id="e1" source="adc" target="spruj26a"><data key="rel">documented_in</data><data key="evidence">Described in SPRUJ26A: ADC</data></edge>
<edge id="e2" source="adc" target="motor1ctrlisr"><data key="rel">input_to</data><data key="evidence">The ISR will be triggered by ADC End of Conversion (EOC)</data></edge>
<edge id="e3" source="adc" target="dc_bus_voltage"><data key="rel">measures</data><data key="evidence">Sampled measurements of dc bus power supply voltage.</data></edge>
<edge id="e4" source="adc" target="motor_phase_current"><data key="rel">measures</data><data key="evidence">HAL_readAdcData reads Ia, Ib, Ic from ADC driver.</data></edge>
<edge id="e5" source="adc" target="motor_phase_voltage"><data key="rel">measures</data><data key="evidence">Sampled measurements of voltage on each motor phase (Va, Vb, Vc to ADC).</data></edge>
<edge id="e6" source="adc" target="three_shunt_current_sensing"><data key="rel">measures</data><data key="evidence">ISENA/ISENB/ISENC sampled on ADCINA11, C4, C7 (three-shunt)</data></edge>
<edge id="e7" source="adc_offset_calibration" target="adc"><data key="rel">configures</data><data key="evidence">Run ADC Offset Calculation; PWM duty 50%. | loaded into motorVars_M1.adcData.offset_I_ad.value[2:0] after calibration</data></edge>
<edge id="e8" source="adc_offset_calibration" target="current_reconstruction"><data key="rel">precedes</data><data key="evidence">Remove ADC Offsets, then Current Reconstruction.</data></edge>
<edge id="e9" source="additional_functionality" target="spruj26a"><data key="rel">documented_in</data><data key="evidence">Described in SPRUJ26A: Adding additional functionality</data></edge>
<edge id="e10" source="additional_functionality" target="universal_motor_control_lab"><data key="rel">extends</data><data key="evidence">The example lab project provides several interface functions</data></edge>
